 CONFIG_DRAM_SUN8I_V831_TPR13=0x34000903
+# musl toolchain's assembler rejects dmb sy in Thumb mode; build ARM mode
+# CONFIG_SYS_THUMB_BUILD is not set
+# CONFIG_SPL_SYS_THUMB_BUILD is not set
diff --git a/openipc/sd_config b/openipc/sd_config
new file mode 100644
index 0000000000000000000000000000000000000000..321143da442966b8500eaff382d8ee0a55c389d5
--- /dev/null
+++ b/openipc/sd_config
@@ -0,0 +1,13 @@
+# SD boot: boot the mainline 7.3.4 kernel/DTB/initramfs from the FAT partition
+# instead of the OpenIPC NOR image.  The camera's boot ROM tries SD first.
+CONFIG_CMD_BOOTZ=y
+# CONFIG_SILENT_CONSOLE is not set
+CONFIG_BOOTDELAY=3
+CONFIG_BOOTCOMMAND="mmc dev 0; fatload mmc 0:1 0x41000000 zImage; fatload mmc 0:1 0x43000000 initramfs.cpio.gz; setenv initrd_size ${filesize}; fatload mmc 0:1 0x42000000 sun8i-v831-yi-y623.dtb; setenv bootargs earlycon console=ttyS0,115200 rdinit=/init; bootz 0x41000000 0x43000000:${initrd_size} 0x42000000"
+# Boot at once and never read the console: UART0 RX floats on this board
+# and noise (a Ctrl-C byte) stopped autoboot -> "hung" reboots. Also no
+# boot counter: its DRAM word survives warm resets, Linux never clears it,
+# and after bootlimit warm boots altbootcmd tried the OpenIPC NOR layout
+# (not on this camera) and stopped in U-Boot.
+CONFIG_BOOTDELAY=-2
+# CONFIG_BOOTCOUNT_LIMIT is not set
