# Minimal WPA2-PSK supplicant for the y623 camera (rtl8189fs via wireless extensions).
# Only enabled options are listed: the Makefile treats any defined option as "on".
CONFIG_DRIVER_WEXT=y
CONFIG_TLS=internal
CONFIG_CRYPTO=internal
CONFIG_INTERNAL_LIBTOMMATH=y
CONFIG_BACKEND=file
CONFIG_NO_CONFIG_WRITE=y
CONFIG_NO_STDOUT_DEBUG=y
CONFIG_L2_PACKET=linux
CONFIG_OS=unix
CONFIG_ELOOP=eloop
CONFIG_NO_WPA_PASSPHRASE=y
CFLAGS += -Os -ffunction-sections -fdata-sections -flto
LDFLAGS += -static -Wl,--gc-sections -flto
