Subject: [PATCH] media: i2c: add GalaxyCore GC3003 sensor driver

Mainline V4L2 subdev driver. Register sequences and the analogue gain table
come from the GPL-2.0 Rockchip gc3003 driver.

---
 drivers/media/i2c/Kconfig       |  10 +
 drivers/media/i2c/Makefile      |   1 +
 drivers/media/i2c/gc3003.c      | 660 ++++++++++++++++++++++++++++++++++++++
 drivers/media/i2c/gc3003_regs.h | 185 +++++++++++
 4 files changed, 856 insertions(+)

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 5c52007f9cbeb77fa3adf3008428f4d1dc529203..81af00cf7d9fa51bd84f897e105369cdf4262a4d 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -100,6 +100,16 @@ config VIDEO_GC08A3
 	  To compile this driver as a module, choose M here: the
 	  module will be called gc08a3.
 
+config VIDEO_GC3003
+	tristate "GalaxyCore GC3003 sensor support"
+	select V4L2_CCI_I2C
+	help
+	  This is a Video4Linux2 sensor driver for the GalaxyCore GC3003
+	  3 MP MIPI CSI-2 camera.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called gc3003.
+
 config VIDEO_GC2145
 	select V4L2_CCI_I2C
 	tristate "GalaxyCore GC2145 sensor support"
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index d04bd5724552e88fc2ad39f9bbaf9b4ce1763939..331307f0b67b93d5c3dae5264f2323856c1ed8da 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -42,6 +42,7 @@ obj-$(CONFIG_VIDEO_GC0310) += gc0310.o
 obj-$(CONFIG_VIDEO_GC05A2) += gc05a2.o
 obj-$(CONFIG_VIDEO_GC08A3) += gc08a3.o
 obj-$(CONFIG_VIDEO_GC2145) += gc2145.o
+obj-$(CONFIG_VIDEO_GC3003) += gc3003.o
 obj-$(CONFIG_VIDEO_HI556) += hi556.o
 obj-$(CONFIG_VIDEO_HI846) += hi846.o
 obj-$(CONFIG_VIDEO_HI847) += hi847.o
diff --git a/drivers/media/i2c/gc3003.c b/drivers/media/i2c/gc3003.c
new file mode 100644
index 0000000000000000000000000000000000000000..e7b9fff3c02bb1610e7bf1a4e121e5f103d5a8e7
--- /dev/null
+++ b/drivers/media/i2c/gc3003.c
@@ -0,0 +1,660 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * GalaxyCore GC3003 3 MP MIPI CSI-2 image sensor driver
+ *
+ * Mainline rewrite. The register sequences and the analogue gain table come
+ * from the GPL-2.0 Rockchip gc3003 driver (Copyright (C) 2022 Rockchip
+ * Electronics Co., Ltd.); see gc3003_regs.h.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+#include "gc3003_regs.h"
+
+#define GC3003_CHIP_ID			0x3003
+#define GC3003_REG_CHIP_ID		CCI_REG16(0x03f0)
+
+#define GC3003_REG_EXPOSURE		CCI_REG16(0x0d03)
+#define GC3003_EXPOSURE_MIN		4
+#define GC3003_EXPOSURE_MARGIN		4
+#define GC3003_REG_VTS			CCI_REG16(0x0d41)
+#define GC3003_VTS_MAX			0x7fff
+#define GC3003_REG_TEST_PATTERN		CCI_REG8(0x018c)
+#define GC3003_TEST_PATTERN_ENABLE	0x17
+#define GC3003_REG_FLIP_MIRROR		CCI_REG8(0x0015)
+#define GC3003_MIRROR_BIT		BIT(0)
+#define GC3003_FLIP_BIT			BIT(3)
+
+#define GC3003_GAIN_MIN			64
+#define GC3003_GAIN_MAX			4095
+#define GC3003_GAIN_DEFAULT		64
+
+#define GC3003_MCLK_FREQ		(27 * HZ_PER_MHZ)
+#define GC3003_LANES			2
+#define GC3003_BPP			10
+#define GC3003_LINK_FREQ		315000000ULL
+#define GC3003_PIXEL_RATE \
+	(GC3003_LINK_FREQ * 2 * GC3003_LANES / GC3003_BPP)
+
+#define GC3003_WIDTH			2304
+#define GC3003_HEIGHT			1296	/* 1298 in the Rockchip tables; the CSI parser measures 1296 */
+#define GC3003_HTS			(0x540 * 2)
+#define GC3003_VTS_DEF			0x053c
+#define GC3003_EXPOSURE_DEF		0x0500
+#define GC3003_MBUS_CODE		MEDIA_BUS_FMT_SRGGB10_1X10
+
+static const char *const gc3003_supply_names[] = {
+	"avdd",		/* analog 2.8 V */
+	"dovdd",	/* I/O 1.8 V */
+	"dvdd",		/* core 1.2 V */
+};
+
+static const s64 gc3003_link_freqs[] = { GC3003_LINK_FREQ };
+
+static const char *const gc3003_test_pattern_menu[] = {
+	"Disabled",
+	"Colour Bars",
+};
+
+/* Analogue gain steps (x64 fixed point) and their register settings. */
+static const u32 gc3003_gain_levels[] = {
+	64, 76, 90, 106, 128, 152, 179, 212, 256, 303, 358, 425, 512,
+	607, 716, 848, 1024, 1214, 1434, 1699, 2048, 2427, 2865, 3393, 4096,
+};
+
+/* regs 0x00d1, 0x00d0, 0x0080, 0x0155, 0x00b8, 0x00b9 */
+static const u8 gc3003_gain_regs[][6] = {
+	{ 0x00, 0x00, 0x05, 0x01, 0x01, 0x00 },
+	{ 0x0a, 0x00, 0x06, 0x01, 0x01, 0x0c },
+	{ 0x00, 0x01, 0x06, 0x01, 0x01, 0x1a },
+	{ 0x0a, 0x01, 0x08, 0x01, 0x01, 0x2a },
+	{ 0x20, 0x00, 0x0a, 0x02, 0x02, 0x00 },
+	{ 0x25, 0x00, 0x0a, 0x03, 0x02, 0x18 },
+	{ 0x20, 0x01, 0x0a, 0x04, 0x02, 0x33 },
+	{ 0x25, 0x01, 0x0b, 0x05, 0x03, 0x14 },
+	{ 0x30, 0x00, 0x0b, 0x06, 0x04, 0x00 },
+	{ 0x32, 0x80, 0x0c, 0x09, 0x04, 0x2f },
+	{ 0x30, 0x01, 0x0c, 0x0c, 0x05, 0x26 },
+	{ 0x32, 0x81, 0x0d, 0x0e, 0x06, 0x29 },
+	{ 0x38, 0x00, 0x0e, 0x10, 0x08, 0x00 },
+	{ 0x39, 0x40, 0x10, 0x12, 0x09, 0x1f },
+	{ 0x38, 0x01, 0x12, 0x12, 0x0b, 0x0d },
+	{ 0x39, 0x41, 0x14, 0x14, 0x0d, 0x12 },
+	{ 0x30, 0x08, 0x15, 0x16, 0x10, 0x00 },
+	{ 0x32, 0x88, 0x18, 0x1a, 0x12, 0x3e },
+	{ 0x30, 0x09, 0x1a, 0x1d, 0x16, 0x1a },
+	{ 0x32, 0x89, 0x1c, 0x22, 0x1a, 0x23 },
+	{ 0x38, 0x08, 0x1e, 0x26, 0x20, 0x00 },
+	{ 0x39, 0x48, 0x20, 0x2d, 0x25, 0x3b },
+	{ 0x38, 0x09, 0x22, 0x32, 0x2c, 0x33 },
+	{ 0x39, 0x49, 0x24, 0x3a, 0x35, 0x06 },
+	{ 0x38, 0x0a, 0x26, 0x42, 0x3f, 0x3f },
+};
+
+struct gc3003 {
+	struct device *dev;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct regmap *regmap;
+	struct clk *mclk;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *pwdn_gpio;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(gc3003_supply_names)];
+
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *hflip;
+	struct v4l2_ctrl *vflip;
+};
+
+static inline struct gc3003 *to_gc3003(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct gc3003, sd);
+}
+
+static int gc3003_power_on(struct device *dev)
+{
+	struct gc3003 *gc3003 = to_gc3003(dev_get_drvdata(dev));
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(gc3003->supplies),
+				    gc3003->supplies);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(gc3003->mclk);
+	if (ret) {
+		regulator_bulk_disable(ARRAY_SIZE(gc3003->supplies),
+				       gc3003->supplies);
+		return ret;
+	}
+
+	/* Logical levels: 1 = asserted (in reset / powered down). */
+	usleep_range(1000, 1100);
+	gpiod_set_value_cansleep(gc3003->pwdn_gpio, 0);
+	usleep_range(100, 150);
+	gpiod_set_value_cansleep(gc3003->reset_gpio, 0);
+
+	/* 8192 MCLK cycles before the first SCCB transaction (~0.3 ms) */
+	usleep_range(1000, 2000);
+
+	return 0;
+}
+
+static int gc3003_power_off(struct device *dev)
+{
+	struct gc3003 *gc3003 = to_gc3003(dev_get_drvdata(dev));
+
+	gpiod_set_value_cansleep(gc3003->reset_gpio, 1);
+	gpiod_set_value_cansleep(gc3003->pwdn_gpio, 1);
+	clk_disable_unprepare(gc3003->mclk);
+	regulator_bulk_disable(ARRAY_SIZE(gc3003->supplies), gc3003->supplies);
+
+	return 0;
+}
+
+static int gc3003_set_gain(struct gc3003 *gc3003, u32 gain)
+{
+	static const u16 regs[] = { 0x00d1, 0x00d0, 0x0080, 0x0155,
+				    0x00b8, 0x00b9 };
+	unsigned int i, idx = 0;
+	u32 dgain;
+	int ret = 0;
+
+	gain = clamp(gain, (u32)GC3003_GAIN_MIN, (u32)GC3003_GAIN_MAX);
+	for (i = 0; i < ARRAY_SIZE(gc3003_gain_levels); i++)
+		if (gc3003_gain_levels[i] <= gain)
+			idx = i;
+
+	for (i = 0; i < ARRAY_SIZE(regs); i++)
+		cci_write(gc3003->regmap, CCI_REG8(regs[i]),
+			  gc3003_gain_regs[idx][i], &ret);
+
+	/* residual digital gain, 6.6 fixed point */
+	dgain = gain * 64 / gc3003_gain_levels[idx];
+	cci_write(gc3003->regmap, CCI_REG8(0x00b1), dgain >> 6, &ret);
+	cci_write(gc3003->regmap, CCI_REG8(0x00b2), (dgain & 0x3f) << 2, &ret);
+
+	return ret;
+}
+
+static int gc3003_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct gc3003 *gc3003 = container_of(ctrl->handler, struct gc3003,
+					     ctrls);
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		s64 max = GC3003_HEIGHT + ctrl->val - GC3003_EXPOSURE_MARGIN;
+
+		__v4l2_ctrl_modify_range(gc3003->exposure,
+					 gc3003->exposure->minimum, max,
+					 gc3003->exposure->step,
+					 min(gc3003->exposure->default_value,
+					     max));
+	}
+
+	if (!pm_runtime_get_if_active(gc3003->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(gc3003->regmap, GC3003_REG_EXPOSURE, ctrl->val, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = gc3003_set_gain(gc3003, ctrl->val);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(gc3003->regmap, GC3003_REG_VTS,
+			  GC3003_HEIGHT + ctrl->val, &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		cci_write(gc3003->regmap, GC3003_REG_TEST_PATTERN,
+			  ctrl->val ? GC3003_TEST_PATTERN_ENABLE : 0, &ret);
+		break;
+	case V4L2_CID_HFLIP:
+		cci_update_bits(gc3003->regmap, GC3003_REG_FLIP_MIRROR,
+				GC3003_MIRROR_BIT,
+				ctrl->val ? GC3003_MIRROR_BIT : 0, &ret);
+		break;
+	case V4L2_CID_VFLIP:
+		cci_update_bits(gc3003->regmap, GC3003_REG_FLIP_MIRROR,
+				GC3003_FLIP_BIT,
+				ctrl->val ? GC3003_FLIP_BIT : 0, &ret);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(gc3003->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops gc3003_ctrl_ops = {
+	.s_ctrl = gc3003_set_ctrl,
+};
+
+static int gc3003_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct gc3003 *gc3003 = to_gc3003(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(gc3003->dev);
+	if (ret)
+		return ret;
+
+	ret = cci_multi_reg_write(gc3003->regmap, gc3003_2304x1298_regs,
+				  ARRAY_SIZE(gc3003_2304x1298_regs), NULL);
+	if (ret)
+		goto err;
+
+	ret = __v4l2_ctrl_handler_setup(&gc3003->ctrls);
+	if (ret)
+		goto err;
+
+	ret = cci_multi_reg_write(gc3003->regmap, gc3003_stream_on_regs,
+				  ARRAY_SIZE(gc3003_stream_on_regs), NULL);
+	if (ret)
+		goto err;
+
+	__v4l2_ctrl_grab(gc3003->hflip, true);
+	__v4l2_ctrl_grab(gc3003->vflip, true);
+
+	return 0;
+
+err:
+	pm_runtime_put(gc3003->dev);
+	return ret;
+}
+
+static int gc3003_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct gc3003 *gc3003 = to_gc3003(sd);
+	int ret;
+
+	ret = cci_multi_reg_write(gc3003->regmap, gc3003_stand_by_regs,
+				  ARRAY_SIZE(gc3003_stand_by_regs), NULL);
+
+	__v4l2_ctrl_grab(gc3003->hflip, false);
+	__v4l2_ctrl_grab(gc3003->vflip, false);
+	pm_runtime_put(gc3003->dev);
+
+	return ret;
+}
+
+static void gc3003_fill_format(struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = GC3003_MBUS_CODE;
+	fmt->width = GC3003_WIDTH;
+	fmt->height = GC3003_HEIGHT;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int gc3003_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+	code->code = GC3003_MBUS_CODE;
+	return 0;
+}
+
+static int gc3003_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index || fse->code != GC3003_MBUS_CODE)
+		return -EINVAL;
+	fse->min_width = fse->max_width = GC3003_WIDTH;
+	fse->min_height = fse->max_height = GC3003_HEIGHT;
+	return 0;
+}
+
+static int gc3003_set_fmt(struct v4l2_subdev *sd,
+			  struct v4l2_subdev_state *state,
+			  struct v4l2_subdev_format *fmt)
+{
+	/* Single fixed mode */
+	gc3003_fill_format(&fmt->format);
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+	return 0;
+}
+
+static int gc3003_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = GC3003_WIDTH;
+		sel->r.height = GC3003_HEIGHT;
+		return 0;
+	}
+	return -EINVAL;
+}
+
+static int gc3003_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	gc3003_fill_format(v4l2_subdev_state_get_format(state, 0));
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops gc3003_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops gc3003_pad_ops = {
+	.enum_mbus_code = gc3003_enum_mbus_code,
+	.enum_frame_size = gc3003_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = gc3003_set_fmt,
+	.get_selection = gc3003_get_selection,
+	.enable_streams = gc3003_enable_streams,
+	.disable_streams = gc3003_disable_streams,
+};
+
+static const struct v4l2_subdev_ops gc3003_subdev_ops = {
+	.video = &gc3003_video_ops,
+	.pad = &gc3003_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops gc3003_internal_ops = {
+	.init_state = gc3003_init_state,
+};
+
+static int gc3003_init_controls(struct gc3003 *gc3003)
+{
+	const struct v4l2_ctrl_ops *ops = &gc3003_ctrl_ops;
+	struct v4l2_ctrl_handler *hdl = &gc3003->ctrls;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *ctrl;
+	int vblank = GC3003_VTS_DEF - GC3003_HEIGHT;
+	int ret;
+
+	v4l2_ctrl_handler_init(hdl, 12);
+
+	ctrl = v4l2_ctrl_new_int_menu(hdl, ops, V4L2_CID_LINK_FREQ,
+				      ARRAY_SIZE(gc3003_link_freqs) - 1, 0,
+				      gc3003_link_freqs);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_PIXEL_RATE, GC3003_PIXEL_RATE,
+			  GC3003_PIXEL_RATE, 1, GC3003_PIXEL_RATE);
+
+	gc3003->hblank = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HBLANK,
+					   GC3003_HTS - GC3003_WIDTH,
+					   GC3003_HTS - GC3003_WIDTH, 1,
+					   GC3003_HTS - GC3003_WIDTH);
+	if (gc3003->hblank)
+		gc3003->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	gc3003->vblank = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VBLANK, vblank,
+					   GC3003_VTS_MAX - GC3003_HEIGHT, 1,
+					   vblank);
+
+	gc3003->exposure = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_EXPOSURE,
+					     GC3003_EXPOSURE_MIN,
+					     GC3003_VTS_DEF -
+					     GC3003_EXPOSURE_MARGIN,
+					     1, GC3003_EXPOSURE_DEF);
+
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN, GC3003_GAIN_MIN,
+			  GC3003_GAIN_MAX, 1, GC3003_GAIN_DEFAULT);
+
+	gc3003->hflip = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HFLIP, 0, 1, 1, 0);
+	gc3003->vflip = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VFLIP, 0, 1, 1, 0);
+	if (gc3003->hflip)
+		gc3003->hflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+	if (gc3003->vflip)
+		gc3003->vflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	v4l2_ctrl_new_std_menu_items(hdl, ops, V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(gc3003_test_pattern_menu) - 1,
+				     0, 0, gc3003_test_pattern_menu);
+
+	ret = v4l2_fwnode_device_parse(gc3003->dev, &props);
+	if (ret)
+		goto err;
+	v4l2_ctrl_new_fwnode_properties(hdl, ops, &props);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto err;
+	}
+
+	gc3003->sd.ctrl_handler = hdl;
+	return 0;
+
+err:
+	v4l2_ctrl_handler_free(hdl);
+	return ret;
+}
+
+/*
+ * The MIPI endpoint is optional for now: the V831 CSI-2 receiver has no
+ * mainline driver yet, and the sensor can still be identified without it.
+ */
+static int gc3003_check_endpoint(struct gc3003 *gc3003)
+{
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *ep;
+	int ret;
+
+	ep = fwnode_graph_get_endpoint_by_id(dev_fwnode(gc3003->dev), 0, 0,
+					     FWNODE_GRAPH_ENDPOINT_NEXT);
+	if (!ep) {
+		dev_warn(gc3003->dev, "no MIPI endpoint, sensor not linked\n");
+		return 0;
+	}
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return dev_err_probe(gc3003->dev, ret,
+				     "failed to parse endpoint\n");
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != GC3003_LANES)
+		ret = dev_err_probe(gc3003->dev, -EINVAL,
+				    "only 2 data lanes are supported\n");
+	else if (bus_cfg.nr_of_link_frequencies != 1 ||
+		 bus_cfg.link_frequencies[0] != GC3003_LINK_FREQ)
+		ret = dev_err_probe(gc3003->dev, -EINVAL,
+				    "link-frequencies must be <%llu>\n",
+				    GC3003_LINK_FREQ);
+
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+	return ret;
+}
+
+static int gc3003_identify(struct gc3003 *gc3003)
+{
+	u64 id;
+	int ret;
+
+	ret = cci_read(gc3003->regmap, GC3003_REG_CHIP_ID, &id, NULL);
+	if (ret)
+		return dev_err_probe(gc3003->dev, ret,
+				     "failed to read chip id\n");
+	if (id != GC3003_CHIP_ID)
+		return dev_err_probe(gc3003->dev, -ENODEV,
+				     "unexpected chip id 0x%04llx\n", id);
+
+	dev_info(gc3003->dev, "GC3003 detected (chip id 0x%04llx)\n", id);
+	return 0;
+}
+
+static int gc3003_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct gc3003 *gc3003;
+	unsigned long rate;
+	unsigned int i;
+	int ret;
+
+	gc3003 = devm_kzalloc(dev, sizeof(*gc3003), GFP_KERNEL);
+	if (!gc3003)
+		return -ENOMEM;
+	gc3003->dev = dev;
+
+	ret = gc3003_check_endpoint(gc3003);
+	if (ret)
+		return ret;
+
+	gc3003->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(gc3003->regmap))
+		return dev_err_probe(dev, PTR_ERR(gc3003->regmap),
+				     "failed to init CCI\n");
+
+	gc3003->mclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(gc3003->mclk))
+		return dev_err_probe(dev, PTR_ERR(gc3003->mclk),
+				     "failed to get mclk\n");
+	rate = clk_get_rate(gc3003->mclk);
+	if (rate != GC3003_MCLK_FREQ)
+		dev_warn(dev, "mclk is %lu Hz, modes assume %lu Hz\n",
+			 rate, (unsigned long)GC3003_MCLK_FREQ);
+
+	for (i = 0; i < ARRAY_SIZE(gc3003_supply_names); i++)
+		gc3003->supplies[i].supply = gc3003_supply_names[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(gc3003->supplies),
+				      gc3003->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	/* Both lines are optional */
+	gc3003->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(gc3003->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(gc3003->reset_gpio),
+				     "failed to get reset gpio\n");
+	gc3003->pwdn_gpio = devm_gpiod_get_optional(dev, "powerdown",
+						    GPIOD_OUT_HIGH);
+	if (IS_ERR(gc3003->pwdn_gpio))
+		return dev_err_probe(dev, PTR_ERR(gc3003->pwdn_gpio),
+				     "failed to get powerdown gpio\n");
+
+	v4l2_i2c_subdev_init(&gc3003->sd, client, &gc3003_subdev_ops);
+	gc3003->sd.internal_ops = &gc3003_internal_ops;
+
+	ret = gc3003_power_on(dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to power on\n");
+
+	ret = gc3003_identify(gc3003);
+	if (ret)
+		goto err_power_off;
+
+	ret = gc3003_init_controls(gc3003);
+	if (ret)
+		goto err_power_off;
+
+	gc3003->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	gc3003->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	gc3003->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&gc3003->sd.entity, 1, &gc3003->pad);
+	if (ret)
+		goto err_ctrls;
+
+	gc3003->sd.state_lock = gc3003->ctrls.lock;
+	ret = v4l2_subdev_init_finalize(&gc3003->sd);
+	if (ret)
+		goto err_entity;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&gc3003->sd);
+	if (ret)
+		goto err_pm;
+
+	pm_runtime_idle(dev);
+	return 0;
+
+err_pm:
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+	v4l2_subdev_cleanup(&gc3003->sd);
+err_entity:
+	media_entity_cleanup(&gc3003->sd.entity);
+err_ctrls:
+	v4l2_ctrl_handler_free(&gc3003->ctrls);
+err_power_off:
+	gc3003_power_off(dev);
+	return ret;
+}
+
+static void gc3003_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct gc3003 *gc3003 = to_gc3003(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&gc3003->ctrls);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		gc3003_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(gc3003_pm_ops, gc3003_power_off,
+				 gc3003_power_on, NULL);
+
+static const struct of_device_id gc3003_of_match[] = {
+	{ .compatible = "galaxycore,gc3003" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, gc3003_of_match);
+
+static struct i2c_driver gc3003_driver = {
+	.driver = {
+		.name = "gc3003",
+		.of_match_table = gc3003_of_match,
+		.pm = pm_ptr(&gc3003_pm_ops),
+	},
+	.probe = gc3003_probe,
+	.remove = gc3003_remove,
+};
+module_i2c_driver(gc3003_driver);
+
+MODULE_DESCRIPTION("GalaxyCore GC3003 image sensor driver");
+MODULE_LICENSE("GPL");
