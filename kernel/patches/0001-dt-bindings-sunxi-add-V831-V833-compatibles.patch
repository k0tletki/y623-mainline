 .../bindings/mmc/allwinner,sun4i-a10-mmc.yaml     |  3 +
 .../pinctrl/allwinner,sun4i-a10-pinctrl.yaml      |  2 +
 .../bindings/spi/allwinner,sun6i-a31-spi.yaml     |  1 +
 .../watchdog/allwinner,sun4i-a10-wdt.yaml         |  3 +
 include/dt-bindings/clock/sun8i-v833-ccu.h        | 94 +++++++++++++++++++++
 include/dt-bindings/reset/sun8i-v833-ccu.h        | 54 ++++++++++++
 7 files changed, 158 insertions(+)

