Subject: [PATCH] ASoC: sunxi: add V831 internal audio codec

Mic ADC and line/speaker DAC with the analog block in the same MMIO window.

---
 sound/soc/sunxi/Kconfig            |  10 +
 sound/soc/sunxi/Makefile           |   1 +
 sound/soc/sunxi/sun8i-v831-codec.c | 620 +++++++++++++++++++++++++++++++++++
 3 files changed, 631 insertions(+)

diff --git a/sound/soc/sunxi/Kconfig b/sound/soc/sunxi/Kconfig
index 205f422d9ded19e400d8cd2da5c0cf2b7b0fa801..2b7d929aea1ae3f83b091a75f5e6e1b8b6c8a5c7 100644
--- a/sound/soc/sunxi/Kconfig
+++ b/sound/soc/sunxi/Kconfig
@@ -2,6 +2,16 @@
 menu "Allwinner"
 	depends on ARCH_SUNXI || COMPILE_TEST
 
+config SND_SUN8I_V831_CODEC
+	tristate "Allwinner V831/V833 internal audio codec"
+	depends on ARCH_SUNXI || COMPILE_TEST
+	depends on OF
+	select REGMAP_MMIO
+	select SND_SOC_GENERIC_DMAENGINE_PCM
+	help
+	  Mono microphone ADC and line-out DAC of the Allwinner V831/V833
+	  (sun8iw19), with an optional GPIO-switched speaker amplifier.
+
 config SND_SUN4I_CODEC
 	tristate "Allwinner A10 Codec Support"
 	select SND_SOC_GENERIC_DMAENGINE_PCM
diff --git a/sound/soc/sunxi/Makefile b/sound/soc/sunxi/Makefile
index 4483fe9c94ef504406675f65db8a67458135881e..3f15e588e48893f718f00653f1fb245bd1e8cc8e 100644
--- a/sound/soc/sunxi/Makefile
+++ b/sound/soc/sunxi/Makefile
@@ -7,3 +7,4 @@ obj-$(CONFIG_SND_SUN50I_CODEC_ANALOG) += sun50i-codec-analog.o
 obj-$(CONFIG_SND_SUN8I_CODEC) += sun8i-codec.o
 obj-$(CONFIG_SND_SUN8I_ADDA_PR_REGMAP) += sun8i-adda-pr-regmap.o
 obj-$(CONFIG_SND_SUN50I_DMIC) += sun50i-dmic.o
+obj-$(CONFIG_SND_SUN8I_V831_CODEC) += sun8i-v831-codec.o
diff --git a/sound/soc/sunxi/sun8i-v831-codec.c b/sound/soc/sunxi/sun8i-v831-codec.c
new file mode 100644
index 0000000000000000000000000000000000000000..faf6ff4fb94a3d0842a200debad0f0ced641e37f
--- /dev/null
+++ b/sound/soc/sunxi/sun8i-v831-codec.c
@@ -0,0 +1,620 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Allwinner V831/V833 (sun8iw19) internal audio codec
+ *
+ * One mono ADC (MIC1 input) and one mono DAC (LINEOUTL), digital and analog
+ * registers in a single MMIO window (analog at 0x300). An external speaker
+ * amplifier hangs off LINEOUTL and is switched by an optional GPIO.
+ *
+ * Register layout and power sequencing follow the GPL-2.0 Allwinner vendor
+ * driver (sound/soc/sunxi/sun8iw19-codec.c) for sun8iw19p1.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/reset.h>
+
+#include <sound/dmaengine_pcm.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+#include <sound/tlv.h>
+
+/* digital */
+#define DAC_DPC			0x00
+#define  DAC_DPC_EN_DAC		BIT(31)
+#define  DAC_DPC_DVOL		GENMASK(17, 12)
+#define DAC_FIFOC		0x10
+#define  DAC_FIFOC_FS		GENMASK(31, 29)
+#define  DAC_FIFOC_FIFO_MODE	GENMASK(25, 24)
+#define  DAC_FIFOC_MONO_EN	BIT(6)
+#define  DAC_FIFOC_SAMPLE_BITS	BIT(5)
+#define  DAC_FIFOC_DRQ_EN	BIT(4)
+#define  DAC_FIFOC_FLUSH	BIT(0)
+#define DAC_FIFOS		0x14
+#define DAC_TXDATA		0x20
+#define DAC_CNT			0x24
+#define ADC_FIFOC		0x30
+#define  ADC_FIFOC_FS		GENMASK(31, 29)
+#define  ADC_FIFOC_EN_AD	BIT(28)
+#define  ADC_FIFOC_FDT		GENMASK(27, 26)
+#define  ADC_FIFOC_DFEN		BIT(25)
+#define  ADC_FIFOC_RX_FIFO_MODE	BIT(24)
+#define  ADC_FIFOC_SAMPLE_BITS	BIT(16)
+#define  ADC_FIFOC_CHAN_SEL	BIT(12)
+#define  ADC_FIFOC_DRQ_EN	BIT(3)
+#define  ADC_FIFOC_FLUSH	BIT(0)
+#define ADC_FIFOS		0x38
+#define ADC_RXDATA		0x40
+#define ADC_CNT			0x44
+#define ADC_DAP_CTL		0xf8
+#define  ADC_DAP_EN		BIT(31)
+#define  ADC_DAP_HPF_EN		BIT(28)
+#define ADC_DRC_HHPFC		0x200
+#define ADC_DRC_LHPFC		0x204
+#define AC_VERSION		0x2c0
+/* analog */
+#define ADCL_ANA_CTL		0x300
+#define  ADCL_EN		31
+#define  ADCL_MIC1AMPEN		30
+#define  ADCL_IOPLINE		GENMASK(21, 20)
+#define  ADCL_PGA_GAIN		8	/* [12:8] */
+#define DAC_ANA_CTL		0x310
+#define  DAC_ANA_DACLEN		15
+#define  DAC_ANA_LINEOUTL_EN	BIT(13)
+#define  DAC_ANA_DACLMUTE	BIT(12)	/* 1 = unmuted */
+#define  DAC_ANA_LINEOUT_VOL	0	/* [4:0] */
+#define MICBIAS_ANA_CTL		0x318
+#define  MICBIAS_MMICBIASEN	7
+#define CODEC_MAX_REG		0x320
+
+#define CODEC_FIFO_BURST	4
+
+struct v831_codec {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *clk_bus;
+	struct clk *clk_mod;
+	struct reset_control *rst;
+	struct gpio_desc *pa_gpio;
+	u32 pa_delay_ms;
+	struct snd_dmaengine_dai_dma_data playback_dma;
+	struct snd_dmaengine_dai_dma_data capture_dma;
+};
+
+/*
+ * The card, the codec component and the CPU DAI all live on one platform
+ * device, and snd_soc_register_card() takes over its driver data, so the
+ * codec state is kept as the card's private data instead.
+ */
+#define to_v831(comp)	((struct v831_codec *)snd_soc_card_get_drvdata((comp)->card))
+
+/* FS field for DAC_FIFOC[31:29] / ADC_FIFOC[31:29] */
+static int v831_codec_fs(unsigned int rate)
+{
+	switch (rate) {
+	case 48000: case 44100:	return 0;
+	case 32000:		return 1;
+	case 24000: case 22050:	return 2;
+	case 16000:		return 3;
+	case 12000: case 11025:	return 4;
+	case 8000:		return 5;
+	case 192000:		return 6;
+	case 96000:		return 7;
+	}
+	return -EINVAL;
+}
+
+/* ADC high-pass filter coefficient per rate, from the vendor driver */
+static u32 v831_codec_hpf_coef(unsigned int rate)
+{
+	switch (rate) {
+	case 16000:	return 0x00f623a5;
+	case 44100:	return 0x00fc60db;
+	default:	return 0x00fcabb3;
+	}
+}
+
+static int v831_codec_hw_params(struct snd_pcm_substream *substream,
+				struct snd_pcm_hw_params *params,
+				struct snd_soc_dai *dai)
+{
+	struct v831_codec *c = to_v831(dai->component);
+	unsigned int rate = params_rate(params);
+	unsigned int chans = params_channels(params);
+	unsigned long clk_rate;
+	int fs, ret;
+
+	fs = v831_codec_fs(rate);
+	if (fs < 0)
+		return fs;
+	if (params_format(params) != SNDRV_PCM_FORMAT_S16_LE)
+		return -EINVAL;
+
+	clk_rate = (rate % 8000) ? 22579200 : 24576000;
+	ret = clk_set_rate(c->clk_mod, clk_rate);
+	if (ret)
+		return ret;
+
+	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK) {
+		regmap_update_bits(c->regmap, DAC_FIFOC,
+				   DAC_FIFOC_FS | DAC_FIFOC_FIFO_MODE |
+				   DAC_FIFOC_SAMPLE_BITS | DAC_FIFOC_MONO_EN,
+				   FIELD_PREP(DAC_FIFOC_FS, fs) |
+				   FIELD_PREP(DAC_FIFOC_FIFO_MODE, 3) |
+				   (chans == 1 ? DAC_FIFOC_MONO_EN : 0));
+	} else {
+		u32 coef = v831_codec_hpf_coef(rate);
+
+		if (chans != 1)
+			return -EINVAL;
+		regmap_update_bits(c->regmap, ADC_FIFOC,
+				   ADC_FIFOC_FS | ADC_FIFOC_RX_FIFO_MODE |
+				   ADC_FIFOC_SAMPLE_BITS | ADC_FIFOC_CHAN_SEL,
+				   FIELD_PREP(ADC_FIFOC_FS, fs) |
+				   ADC_FIFOC_RX_FIFO_MODE | ADC_FIFOC_CHAN_SEL);
+		regmap_write(c->regmap, ADC_DRC_HHPFC, coef >> 16);
+		regmap_write(c->regmap, ADC_DRC_LHPFC, coef & 0xffff);
+	}
+	return 0;
+}
+
+static int v831_codec_startup(struct snd_pcm_substream *substream,
+			      struct snd_soc_dai *dai)
+{
+	struct v831_codec *c = to_v831(dai->component);
+
+	/* DC-removing high-pass filter on the ADC (vendor board: adchpf_cfg) */
+	if (substream->stream == SNDRV_PCM_STREAM_CAPTURE) {
+		regmap_set_bits(c->regmap, ADC_DAP_CTL, ADC_DAP_HPF_EN);
+		regmap_set_bits(c->regmap, ADC_DAP_CTL, ADC_DAP_EN);
+	}
+	return 0;
+}
+
+static void v831_codec_shutdown(struct snd_pcm_substream *substream,
+				struct snd_soc_dai *dai)
+{
+	struct v831_codec *c = to_v831(dai->component);
+
+	if (substream->stream == SNDRV_PCM_STREAM_CAPTURE)
+		regmap_clear_bits(c->regmap, ADC_DAP_CTL,
+				  ADC_DAP_EN | ADC_DAP_HPF_EN);
+}
+
+static int v831_codec_prepare(struct snd_pcm_substream *substream,
+			      struct snd_soc_dai *dai)
+{
+	struct v831_codec *c = to_v831(dai->component);
+
+	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK) {
+		regmap_set_bits(c->regmap, DAC_FIFOC, DAC_FIFOC_FLUSH);
+		regmap_write(c->regmap, DAC_FIFOS, 0xe);
+		regmap_write(c->regmap, DAC_CNT, 0);
+	} else {
+		regmap_set_bits(c->regmap, ADC_FIFOC, ADC_FIFOC_FLUSH);
+		regmap_write(c->regmap, ADC_FIFOS, 0xa);
+		regmap_write(c->regmap, ADC_CNT, 0);
+	}
+	return 0;
+}
+
+static int v831_codec_trigger(struct snd_pcm_substream *substream, int cmd,
+			      struct snd_soc_dai *dai)
+{
+	struct v831_codec *c = to_v831(dai->component);
+	bool play = substream->stream == SNDRV_PCM_STREAM_PLAYBACK;
+	unsigned int reg = play ? DAC_FIFOC : ADC_FIFOC;
+	unsigned int bit = play ? DAC_FIFOC_DRQ_EN : ADC_FIFOC_DRQ_EN;
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		regmap_set_bits(c->regmap, reg, bit);
+		return 0;
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+		regmap_clear_bits(c->regmap, reg, bit);
+		return 0;
+	}
+	return -EINVAL;
+}
+
+static const struct snd_soc_dai_ops v831_codec_dai_ops = {
+	.startup = v831_codec_startup,
+	.shutdown = v831_codec_shutdown,
+	.hw_params = v831_codec_hw_params,
+	.prepare = v831_codec_prepare,
+	.trigger = v831_codec_trigger,
+};
+
+#define V831_RATES (SNDRV_PCM_RATE_8000_48000 | SNDRV_PCM_RATE_96000 | \
+		    SNDRV_PCM_RATE_192000)
+
+static struct snd_soc_dai_driver v831_codec_dai = {
+	.name = "Codec",
+	.ops = &v831_codec_dai_ops,
+	.playback = {
+		.stream_name = "Playback",
+		.channels_min = 1,
+		.channels_max = 2,
+		.rates = V831_RATES,
+		.formats = SNDRV_PCM_FMTBIT_S16_LE,
+	},
+	.capture = {
+		.stream_name = "Capture",
+		.channels_min = 1,
+		.channels_max = 1,
+		.rates = SNDRV_PCM_RATE_8000_48000,
+		.formats = SNDRV_PCM_FMTBIT_S16_LE,
+	},
+};
+
+/* ------------------------------------------------------------------------
+ * DAPM
+ */
+
+static int v831_dac_event(struct snd_soc_dapm_widget *w,
+			  struct snd_kcontrol *k, int event)
+{
+	struct snd_soc_component *comp = snd_soc_dapm_to_component(w->dapm);
+	struct v831_codec *c = to_v831(comp);
+
+	if (SND_SOC_DAPM_EVENT_ON(event)) {
+		regmap_set_bits(c->regmap, DAC_DPC, DAC_DPC_EN_DAC);
+		msleep(30);
+		regmap_set_bits(c->regmap, DAC_ANA_CTL, DAC_ANA_DACLMUTE);
+	} else {
+		regmap_clear_bits(c->regmap, DAC_DPC, DAC_DPC_EN_DAC);
+		regmap_clear_bits(c->regmap, DAC_ANA_CTL, DAC_ANA_DACLMUTE);
+	}
+	return 0;
+}
+
+static int v831_lineout_event(struct snd_soc_dapm_widget *w,
+			      struct snd_kcontrol *k, int event)
+{
+	struct snd_soc_component *comp = snd_soc_dapm_to_component(w->dapm);
+	struct v831_codec *c = to_v831(comp);
+
+	if (SND_SOC_DAPM_EVENT_ON(event)) {
+		msleep(80);
+		regmap_set_bits(c->regmap, DAC_ANA_CTL, DAC_ANA_LINEOUTL_EN);
+	} else {
+		regmap_clear_bits(c->regmap, DAC_ANA_CTL, DAC_ANA_LINEOUTL_EN);
+		msleep(100);
+	}
+	return 0;
+}
+
+static int v831_speaker_event(struct snd_soc_dapm_widget *w,
+			      struct snd_kcontrol *k, int event)
+{
+	struct snd_soc_component *comp = snd_soc_dapm_to_component(w->dapm);
+	struct v831_codec *c = to_v831(comp);
+
+	if (!c->pa_gpio)
+		return 0;
+	if (SND_SOC_DAPM_EVENT_ON(event)) {
+		gpiod_set_value_cansleep(c->pa_gpio, 1);
+		msleep(c->pa_delay_ms);
+	} else {
+		gpiod_set_value_cansleep(c->pa_gpio, 0);
+	}
+	return 0;
+}
+
+static int v831_adc_event(struct snd_soc_dapm_widget *w,
+			  struct snd_kcontrol *k, int event)
+{
+	struct snd_soc_component *comp = snd_soc_dapm_to_component(w->dapm);
+	struct v831_codec *c = to_v831(comp);
+
+	if (SND_SOC_DAPM_EVENT_ON(event)) {
+		msleep(80);
+		regmap_set_bits(c->regmap, ADC_FIFOC, ADC_FIFOC_EN_AD);
+	} else {
+		regmap_clear_bits(c->regmap, ADC_FIFOC, ADC_FIFOC_EN_AD);
+	}
+	return 0;
+}
+
+static const struct snd_soc_dapm_widget v831_codec_widgets[] = {
+	/* playback */
+	SND_SOC_DAPM_DAC_E("DAC", "Playback", DAC_ANA_CTL, DAC_ANA_DACLEN, 0,
+			   v831_dac_event,
+			   SND_SOC_DAPM_POST_PMU | SND_SOC_DAPM_POST_PMD),
+	SND_SOC_DAPM_OUT_DRV_E("Line Out", SND_SOC_NOPM, 0, 0, NULL, 0,
+			       v831_lineout_event,
+			       SND_SOC_DAPM_POST_PMU | SND_SOC_DAPM_PRE_PMD),
+	SND_SOC_DAPM_SPK("Speaker", v831_speaker_event),
+
+	/* capture: mic bias and the MIC1 preamp follow the stream */
+	SND_SOC_DAPM_INPUT("MIC1"),
+	SND_SOC_DAPM_SUPPLY("Mic Bias", MICBIAS_ANA_CTL, MICBIAS_MMICBIASEN, 0,
+			    NULL, 0),
+	SND_SOC_DAPM_PGA("Mic1 Amp", ADCL_ANA_CTL, ADCL_MIC1AMPEN, 0, NULL, 0),
+	SND_SOC_DAPM_ADC_E("ADC", "Capture", ADCL_ANA_CTL, ADCL_EN, 0,
+			   v831_adc_event,
+			   SND_SOC_DAPM_POST_PMU | SND_SOC_DAPM_POST_PMD),
+};
+
+static const struct snd_soc_dapm_route v831_codec_routes[] = {
+	{ "Line Out", NULL, "DAC" },
+	{ "Speaker", NULL, "Line Out" },
+	{ "Mic1 Amp", NULL, "MIC1" },
+	{ "Mic1 Amp", NULL, "Mic Bias" },
+	{ "ADC", NULL, "Mic1 Amp" },
+};
+
+/* LINEOUT_VOL: 0-1 mute, 2..31 = -43.5 dB .. 0 dB in 1.5 dB steps */
+static const DECLARE_TLV_DB_RANGE(v831_lineout_tlv,
+	0, 1, TLV_DB_SCALE_ITEM(TLV_DB_GAIN_MUTE, 0, 1),
+	2, 31, TLV_DB_SCALE_ITEM(-4350, 150, 0),
+);
+/* DVOL is attenuation: 0 = 0 dB, step size per the H616 sibling (-1.16 dB) */
+static const DECLARE_TLV_DB_SCALE(v831_dvol_tlv, -7424, 116, 0);
+/* MIC1 PGA: 0..31, vendor labels it 0..31 dB */
+static const DECLARE_TLV_DB_SCALE(v831_pga_tlv, 0, 100, 0);
+
+static const struct snd_kcontrol_new v831_codec_controls[] = {
+	SOC_SINGLE_TLV("DAC Playback Volume", DAC_DPC, 12, 63, 1,
+		       v831_dvol_tlv),
+	SOC_SINGLE_TLV("Line Out Playback Volume", DAC_ANA_CTL,
+		       DAC_ANA_LINEOUT_VOL, 31, 0, v831_lineout_tlv),
+	SOC_SINGLE_TLV("Mic1 Capture Volume", ADCL_ANA_CTL, ADCL_PGA_GAIN, 31,
+		       0, v831_pga_tlv),
+};
+
+static int v831_codec_component_probe(struct snd_soc_component *comp)
+{
+	struct v831_codec *c = to_v831(comp);
+	unsigned int ver = 0;
+
+	regmap_read(c->regmap, AC_VERSION, &ver);
+	dev_info(c->dev, "codec version 0x%08x\n", ver);
+
+	/* vendor init: ADC delayed-FIFO-start (removes capture start noise) */
+	regmap_update_bits(c->regmap, ADC_FIFOC,
+			   ADC_FIFOC_FDT | ADC_FIFOC_DFEN,
+			   FIELD_PREP(ADC_FIFOC_FDT, 3) | ADC_FIFOC_DFEN);
+	regmap_update_bits(c->regmap, ADCL_ANA_CTL, ADCL_IOPLINE,
+			   FIELD_PREP(ADCL_IOPLINE, 1));
+	/* board defaults: line out 0 dB, DAC 0 dB, MIC1 PGA 23 */
+	regmap_update_bits(c->regmap, DAC_ANA_CTL, 0x1f, 0x1f);
+	regmap_update_bits(c->regmap, DAC_DPC, DAC_DPC_DVOL, 0);
+	regmap_update_bits(c->regmap, ADCL_ANA_CTL, 0x1f << ADCL_PGA_GAIN,
+			   23 << ADCL_PGA_GAIN);
+	return 0;
+}
+
+static const struct snd_soc_component_driver v831_codec_component = {
+	.name = "v831-codec",
+	.probe = v831_codec_component_probe,
+	.controls = v831_codec_controls,
+	.num_controls = ARRAY_SIZE(v831_codec_controls),
+	.dapm_widgets = v831_codec_widgets,
+	.num_dapm_widgets = ARRAY_SIZE(v831_codec_widgets),
+	.dapm_routes = v831_codec_routes,
+	.num_dapm_routes = ARRAY_SIZE(v831_codec_routes),
+	.idle_bias_on = 0,
+	.endianness = 1,
+};
+
+/* ------------------------------------------------------------------------
+ * CPU DAI (DMA side) and the built-in card
+ */
+
+static int v831_cpu_dai_probe(struct snd_soc_dai *dai)
+{
+	struct v831_codec *c = to_v831(dai->component);
+
+	snd_soc_dai_init_dma_data(dai, &c->playback_dma, &c->capture_dma);
+	return 0;
+}
+
+static const struct snd_soc_dai_ops v831_cpu_dai_ops = {
+	.probe = v831_cpu_dai_probe,
+};
+
+static struct snd_soc_dai_driver v831_cpu_dai = {
+	.name = "v831-codec-cpu",
+	.ops = &v831_cpu_dai_ops,
+	.playback = {
+		.stream_name = "Playback",
+		.channels_min = 1,
+		.channels_max = 2,
+		.rates = V831_RATES,
+		.formats = SNDRV_PCM_FMTBIT_S16_LE,
+	},
+	.capture = {
+		.stream_name = "Capture",
+		.channels_min = 1,
+		.channels_max = 1,
+		.rates = SNDRV_PCM_RATE_8000_48000,
+		.formats = SNDRV_PCM_FMTBIT_S16_LE,
+	},
+};
+
+static const struct snd_soc_component_driver v831_cpu_component = {
+	.name = "v831-codec-cpu",
+};
+
+static const struct snd_soc_dapm_widget v831_card_widgets[] = {
+	SND_SOC_DAPM_MIC("Mic", NULL),
+};
+
+static const struct snd_soc_dapm_route v831_card_routes[] = {
+	{ "MIC1", NULL, "Mic" },
+};
+
+static int v831_codec_register_card(struct v831_codec *c)
+{
+	struct device *dev = c->dev;
+	struct snd_soc_dai_link_component *dlc;
+	struct snd_soc_dai_link *link;
+	struct snd_soc_card *card;
+
+	card = devm_kzalloc(dev, sizeof(*card), GFP_KERNEL);
+	link = devm_kzalloc(dev, sizeof(*link), GFP_KERNEL);
+	dlc = devm_kcalloc(dev, 3, sizeof(*dlc), GFP_KERNEL);
+	if (!card || !link || !dlc)
+		return -ENOMEM;
+
+	/*
+	 * Match by DT node: ASoC renames components of "5096000.codec" to
+	 * "codec.05096000", so dev_name() would never match.
+	 */
+	dlc[0].of_node = dev->of_node;		/* cpu */
+	dlc[0].dai_name = "v831-codec-cpu";
+	dlc[1].of_node = dev->of_node;		/* codec */
+	dlc[1].dai_name = "Codec";
+	dlc[2].of_node = dev->of_node;		/* platform (dmaengine pcm) */
+
+	link->name = "v831-codec";
+	link->stream_name = "v831-codec";
+	link->cpus = &dlc[0];
+	link->num_cpus = 1;
+	link->codecs = &dlc[1];
+	link->num_codecs = 1;
+	link->platforms = &dlc[2];
+	link->num_platforms = 1;
+	link->dai_fmt = SND_SOC_DAIFMT_I2S;
+
+	card->dev = dev;
+	snd_soc_card_set_drvdata(card, c);
+	card->owner = THIS_MODULE;
+	card->name = "V831 Audio Codec";
+	card->driver_name = "v831codec";
+	card->dai_link = link;
+	card->num_links = 1;
+	card->dapm_widgets = v831_card_widgets;
+	card->num_dapm_widgets = ARRAY_SIZE(v831_card_widgets);
+	card->dapm_routes = v831_card_routes;
+	card->num_dapm_routes = ARRAY_SIZE(v831_card_routes);
+	card->fully_routed = false;
+
+	return devm_snd_soc_register_card(dev, card);
+}
+
+static const struct regmap_config v831_codec_regmap = {
+	.reg_bits = 32,
+	.reg_stride = 4,
+	.val_bits = 32,
+	.max_register = CODEC_MAX_REG,
+};
+
+static int v831_codec_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct v831_codec *c;
+	struct resource *res;
+	void __iomem *base;
+	int ret;
+
+	c = devm_kzalloc(dev, sizeof(*c), GFP_KERNEL);
+	if (!c)
+		return -ENOMEM;
+	c->dev = dev;
+
+	base = devm_platform_get_and_ioremap_resource(pdev, 0, &res);
+	if (IS_ERR(base))
+		return PTR_ERR(base);
+	c->regmap = devm_regmap_init_mmio(dev, base, &v831_codec_regmap);
+	if (IS_ERR(c->regmap))
+		return PTR_ERR(c->regmap);
+
+	c->clk_bus = devm_clk_get_enabled(dev, "bus");
+	if (IS_ERR(c->clk_bus))
+		return dev_err_probe(dev, PTR_ERR(c->clk_bus), "bus clock\n");
+	c->clk_mod = devm_clk_get(dev, "mod");
+	if (IS_ERR(c->clk_mod))
+		return dev_err_probe(dev, PTR_ERR(c->clk_mod), "mod clock\n");
+	c->rst = devm_reset_control_get_exclusive(dev, NULL);
+	if (IS_ERR(c->rst))
+		return dev_err_probe(dev, PTR_ERR(c->rst), "reset\n");
+
+	c->pa_gpio = devm_gpiod_get_optional(dev, "allwinner,pa", GPIOD_OUT_LOW);
+	if (IS_ERR(c->pa_gpio))
+		return dev_err_probe(dev, PTR_ERR(c->pa_gpio), "pa gpio\n");
+	c->pa_delay_ms = 160;
+	of_property_read_u32(dev->of_node, "allwinner,pa-delay-ms",
+			     &c->pa_delay_ms);
+
+	ret = reset_control_deassert(c->rst);
+	if (ret)
+		return ret;
+	ret = clk_set_rate(c->clk_mod, 24576000);
+	if (!ret)
+		ret = clk_prepare_enable(c->clk_mod);
+	if (ret)
+		goto err_reset;
+
+	c->playback_dma.addr = res->start + DAC_TXDATA;
+	c->playback_dma.addr_width = DMA_SLAVE_BUSWIDTH_2_BYTES;
+	c->playback_dma.maxburst = CODEC_FIFO_BURST;
+	c->capture_dma.addr = res->start + ADC_RXDATA;
+	c->capture_dma.addr_width = DMA_SLAVE_BUSWIDTH_2_BYTES;
+	c->capture_dma.maxburst = CODEC_FIFO_BURST;
+
+	ret = devm_snd_soc_register_component(dev, &v831_codec_component,
+					      &v831_codec_dai, 1);
+	if (ret)
+		goto err_clk;
+	ret = devm_snd_soc_register_component(dev, &v831_cpu_component,
+					      &v831_cpu_dai, 1);
+	if (ret)
+		goto err_clk;
+	ret = devm_snd_dmaengine_pcm_register(dev, NULL, 0);
+	if (ret) {
+		dev_err_probe(dev, ret, "dmaengine pcm\n");
+		goto err_clk;
+	}
+	ret = v831_codec_register_card(c);
+	if (ret) {
+		dev_err_probe(dev, ret, "card\n");
+		goto err_clk;
+	}
+	return 0;
+
+err_clk:
+	clk_disable_unprepare(c->clk_mod);
+err_reset:
+	reset_control_assert(c->rst);
+	return ret;
+}
+
+static void v831_codec_remove(struct platform_device *pdev)
+{
+	struct snd_soc_card *card = platform_get_drvdata(pdev);
+	struct v831_codec *c = snd_soc_card_get_drvdata(card);
+
+	clk_disable_unprepare(c->clk_mod);
+	reset_control_assert(c->rst);
+}
+
+static const struct of_device_id v831_codec_of_match[] = {
+	{ .compatible = "allwinner,sun8i-v831-codec" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, v831_codec_of_match);
+
+static struct platform_driver v831_codec_driver = {
+	.probe = v831_codec_probe,
+	.remove = v831_codec_remove,
+	.driver = {
+		.name = "sun8i-v831-codec",
+		.of_match_table = v831_codec_of_match,
+	},
+};
+module_platform_driver(v831_codec_driver);
+
+MODULE_DESCRIPTION("Allwinner V831 internal audio codec");
+MODULE_LICENSE("GPL");
