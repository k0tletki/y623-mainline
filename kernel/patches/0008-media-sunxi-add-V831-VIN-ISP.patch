+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Allwinner V831/V833 (sun8iw19) video input
+ *
+ *   MIPI CSI-2 -> parser0 -> ISP0 (ISP521) -+-> VIPP0 (scaler) -> DMA0  /dev/video0
+ *                                           +-> VIPP1 (scaler) -> DMA1  /dev/video1
+ *
+ * Channel 1 (optional, if the DT has "vipp1"/"dma1") is a second, independently
+ * scaled NV12 output of the same ISP frame: the low-resolution sub-stream.
+ * Sensor, MIPI, parser and ISP are shared and started by the first channel
+ * that streams; a channel joining later only arms its VIPP and DMA.
+ *
+ * Two output paths on /dev/video0:
+ *  - raw Bayer (SRGGB10 etc.): ISP and VIPP stay disabled, the data passes
+ *    through them unprocessed (vendor behaviour);
+ *  - NV12: ISP debayers to YUV, VIPP optionally downscales.
+ *
+ * The ISP and the VIPP take most of their configuration from memory images
+ * that the hardware loads at each frame start (para_ready protocol). The
+ * ISP image starts from the vendor default register set; its tuning
+ * (black level, gains, CCM, gamma, ...) is not documented in the GPL source,
+ * so the module enable mask is a parameter and the image addresses are
+ * logged for experiments.
+ *
+ * Register sequences follow the GPL-2.0 Allwinner "sunxi-vin" driver for
+ * sun8iw19p1 (bsp_mipi_csi.c, parser_reg.c, isp521_reg_cfg.c, sunxi_isp.c,
+ * vipp_reg.c, sunxi_scaler.c, dma_reg.c, vin_video.c, top_reg.c).
+ */
+
+#include <linux/bitfield.h>
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/platform_device.h>
+#include <linux/reset.h>
+
+#include <media/media-device.h>
+#include <media/v4l2-async.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-ioctl.h>
+#include <media/v4l2-mc.h>
+#include <media/v4l2-subdev.h>
+#include <media/videobuf2-dma-contig.h>
+
+#include "isp521_default.h"
+#include "isp521_gamma.h"
+
+#define VIN_NAME		"sun8i-v831-vin"
+
+static unsigned int isp_modules;
+static unsigned int wb_red = 0x197, wb_blue = 0x1cf;	/* x/256, tuned on a white ceiling */
+static void *vin_isp_load_live;	/* ISP load image while streaming */
+static void vin_wb_apply(void *img)
+{
+	*(u32 *)(img + 0x370) = 0x100 << 16 | (min(wb_red, 0xfffu));
+	*(u32 *)(img + 0x374) = min(wb_blue, 0xfffu) << 16 | 0x100;
+}
+static int vin_wb_set(const char *val, const struct kernel_param *kp)
+{
+	int ret = param_set_uint(val, kp);
+
+	if (!ret && vin_isp_load_live)
+		vin_wb_apply(vin_isp_load_live);
+	return ret;
+}
+static const struct kernel_param_ops vin_wb_ops = {
+	.set = vin_wb_set,
+	.get = param_get_uint,
+};
+module_param_cb(wb_red, &vin_wb_ops, &wb_red, 0644);
+module_param_cb(wb_blue, &vin_wb_ops, &wb_blue, 0644);
+static unsigned int black_level = 256;	/* 12-bit scale: 64 in the sensor's 10 bits */
+module_param(black_level, uint, 0644);
+module_param(isp_modules, uint, 0644);
+MODULE_PARM_DESC(isp_modules,
+		 "ISP module enable mask (load image 0x1a0, SRC0_EN is always added)");
+
+/*
+ * Bring-up aid: "off=val,..." patches words of the ISP load image (the
+ * hardware reloads it at every frame start), e.g. module enables at 0x1a0.
+ * Reading the parameter shows the last poke. Applied immediately when
+ * streaming, otherwise at the next stream start.
+ */
+static char isp_poke_str[4096];
+static u32 isp_poke_off[256], isp_poke_val[256], isp_poke_len[256];
+static unsigned int isp_poke_n;
+
+static void vin_isp_poke_apply(void *img)
+{
+	unsigned int i, o;
+
+	for (i = 0; i < isp_poke_n; i++)
+		for (o = 0; o < isp_poke_len[i]; o += 4)
+			*(u32 *)(img + isp_poke_off[i] + o) = isp_poke_val[i];
+}
+
+static int vin_isp_poke_set(const char *val, const struct kernel_param *kp)
+{
+	unsigned int off, v, n = 0;
+	const char *p = val;
+	int len;
+
+	strscpy(isp_poke_str, val, sizeof(isp_poke_str));
+	while (n < ARRAY_SIZE(isp_poke_off)) {
+		unsigned int flen = 4;
+
+		/* "off=val" or "off+len=val" (fill len bytes) */
+		if (sscanf(p, "%x+%x=%x%n", &off, &flen, &v, &len) != 3) {
+			flen = 4;
+			if (sscanf(p, "%x=%x%n", &off, &v, &len) != 2)
+				break;
+		}
+		if (!(off & 3) && off + flen <= 0x13240) {
+			isp_poke_off[n] = off;
+			isp_poke_len[n] = ALIGN(flen, 4);
+			isp_poke_val[n++] = v;
+		}
+		p += len;
+		if (*p == ',')
+			p++;
+	}
+	isp_poke_n = n;
+	if (vin_isp_load_live)
+		vin_isp_poke_apply(vin_isp_load_live);
+	return 0;
+}
+
+static int vin_isp_peek(char *buf, const struct kernel_param *kp)
+{
+	int n = scnprintf(buf, PAGE_SIZE, "%s\n", isp_poke_str);
+	unsigned int o;
+
+	if (!vin_isp_load_live)
+		return n;
+	for (o = 0x100; o < 0x400 && n < PAGE_SIZE - 64; o += 16)
+		n += scnprintf(buf + n, PAGE_SIZE - n, "%03x: %08x %08x %08x %08x\n", o,
+			       *(u32 *)(vin_isp_load_live + o), *(u32 *)(vin_isp_load_live + o + 4),
+			       *(u32 *)(vin_isp_load_live + o + 8), *(u32 *)(vin_isp_load_live + o + 12));
+	return n;
+}
+
+static const struct kernel_param_ops vin_isp_poke_ops = {
+	.set = vin_isp_poke_set,
+	.get = vin_isp_peek,
+};
+module_param_cb(isp_poke, &vin_isp_poke_ops, NULL, 0644);
