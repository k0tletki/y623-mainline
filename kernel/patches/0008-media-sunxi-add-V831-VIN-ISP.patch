+/* ------------------------------------------------------------------------
+ * Interrupts
+ */
+
+static struct vin_buffer *vin_pop_pending(struct vin_chan *ch)
+{
+	struct vin_buffer *buf;
+
+	buf = list_first_entry_or_null(&ch->pending, struct vin_buffer, list);
+	if (buf)
+		list_del(&buf->list);
+	return buf;
+}
+
+/* DMA: buffer rotation on VSYNC; the address written now is latched at the
+ * next VSYNC.
+ */
+static irqreturn_t vin_dma_irq(int irq, void *data)
+{
+	struct vin_chan *ch = data;
+	u32 sta;
+
+	sta = readl(ch->dma + DMA_INT_STA);
+	writel(sta, ch->dma + DMA_INT_STA);
+	if (!sta)
+		return IRQ_NONE;
+
+	/*
+	 * Low latency: a frame is complete at FD (DMA frame done), not at the
+	 * next VSYNC. Hand it out right away when the hardware already has a
+	 * different buffer latched for the next frame; otherwise the hardware
+	 * will rewrite it, so keep it and count a drop at VSYNC.
+	 * Timestamps are start of frame (VSYNC), see TSTAMP_SRC_SOE.
+	 */
+	if (sta & DMA_INT_FD) {
+		spin_lock(&ch->qlock);
+		ch->irq_fd++;
+		if (ch->active && ch->active != ch->queued &&
+		    !ch->active_done) {
+			struct vb2_v4l2_buffer *vb = &ch->active->vb;
+
+			vb->vb2_buf.timestamp = ch->active_sof_ns;
+			vb->sequence = ch->sequence;
+			vb->field = V4L2_FIELD_NONE;
+			vb2_buffer_done(&vb->vb2_buf, VB2_BUF_STATE_DONE);
+			ch->active_done = true;
+		}
+		spin_unlock(&ch->qlock);
+	}
+
+	if (sta & DMA_INT_OVERFLOW) {
+		ch->irq_overflow++;
+		dev_err_ratelimited(ch->vin->dev,
+				    "ch%u DMA overflow, status 0x%08x\n",
+				    ch->id, sta);
+	}
+
+	if (sta & DMA_INT_VS) {
+		struct vin_buffer *next;
+		u64 now = ktime_get_ns();
+
+		spin_lock(&ch->qlock);
+		ch->irq_vs++;
+
+		if (ch->active && ch->active != ch->queued) {
+			/* FD missed (or both bits in one IRQ): finish it now */
+			if (!ch->active_done) {
+				struct vb2_v4l2_buffer *vb = &ch->active->vb;
+
+				vb->vb2_buf.timestamp = ch->active_sof_ns;
+				vb->sequence = ch->sequence;
+				vb->field = V4L2_FIELD_NONE;
+				vb2_buffer_done(&vb->vb2_buf,
+						VB2_BUF_STATE_DONE);
+			}
+		} else if (ch->active) {
+			/* no new buffer was available: frame overwritten */
+			ch->frames_dropped++;
+		}
+		if (ch->active)
+			ch->sequence++;
+
+		ch->active = ch->queued;
+		ch->active_sof_ns = now;
+		ch->active_done = false;
+		next = vin_pop_pending(ch);
+		if (next) {
+			ch->queued = next;
+			vin_hw_set_addr(ch, next);
+		}
+		spin_unlock(&ch->qlock);
+	}
+
+	return IRQ_HANDLED;
+}
+
+/* ISP: re-arm the load image every frame (para_ready protocol) */
+static irqreturn_t vin_isp_irq(int irq, void *data)
+{
+	struct vin_dev *vin = data;
+	void __iomem *isp = vin->isp;
+	u32 sta;
+
+	sta = readl(isp + ISP_INT_STA) & readl(isp + ISP_INT_EN);
+	if (!sta)
+		return IRQ_NONE;
+	writel(sta, isp + ISP_INT_STA);
+
+	if (sta & ISP_INT_S0_PARA_LOAD) {
+		vin->n_isp_load++;
+		vin_clr(isp, ISP_UPDATE, ISP_UPDATE_PARA_READY);
+		vin_isp_set_size(vin);
+		writel(vin_img_read(vin->isp_load, ISP_IMG_UPDATE) &
+		       ~(BIT(6) | BIT(7)), isp + ISP_UPDATE);
+		vin_set(isp, ISP_UPDATE, ISP_UPDATE_PARA_READY);
+	}
+
+	if (sta & ISP_INT_FINISH)
+		vin->n_isp_finish++;
+
+	if (sta & ISP_INT_ERRORS) {
+		vin->n_isp_err++;
+		vin->isp_err_last = sta | readl(isp + ISP_INTER_STA0) << 16;
+		dev_err_ratelimited(vin->dev,
+				    "ISP error, status 0x%08x inter 0x%08x\n",
+				    sta, readl(isp + ISP_INTER_STA0));
+	}
+
+	return IRQ_HANDLED;
+}
+
+/* ------------------------------------------------------------------------
+ * vb2
+ */
+
+static int vin_queue_setup(struct vb2_queue *q, unsigned int *nbuffers,
+			   unsigned int *nplanes, unsigned int sizes[],
+			   struct device *alloc_devs[])
+{
+	struct vin_chan *ch = vb2_get_drv_priv(q);
+
+	if (*nplanes)
+		return sizes[0] < ch->fmt.sizeimage ? -EINVAL : 0;
+
+	*nplanes = 1;
+	sizes[0] = ch->fmt.sizeimage;
+	return 0;
+}
+
+static int vin_buf_prepare(struct vb2_buffer *vb)
+{
+	struct vin_chan *ch = vb2_get_drv_priv(vb->vb2_queue);
+
+	if (vb2_plane_size(vb, 0) < ch->fmt.sizeimage)
+		return -EINVAL;
+	vb2_set_plane_payload(vb, 0, ch->fmt.sizeimage);
+	return 0;
+}
+
+static void vin_buf_queue(struct vb2_buffer *vb)
+{
+	struct vin_chan *ch = vb2_get_drv_priv(vb->vb2_queue);
+	struct vin_buffer *buf = container_of(to_vb2_v4l2_buffer(vb),
+					      struct vin_buffer, vb);
+	unsigned long flags;
+
+	spin_lock_irqsave(&ch->qlock, flags);
+	/*
+	 * Skip the shortcut when a VSYNC is already pending: the hardware may
+	 * have latched the old address, and the IRQ handler will pick this
+	 * buffer up from the pending list instead.
+	 */
+	if (ch->streaming && ch->queued && ch->queued == ch->active &&
+	    !(readl(ch->dma + DMA_INT_STA) & DMA_INT_VS)) {
+		/*
+		 * The hardware has no spare buffer latched: program this one
+		 * now so it is used from the next frame, not the one after.
+		 */
+		ch->queued = buf;
+		vin_hw_set_addr(ch, buf);
+	} else {
+		list_add_tail(&buf->list, &ch->pending);
+	}
+	spin_unlock_irqrestore(&ch->qlock, flags);
+}
+
+static void vin_return_all(struct vin_chan *ch, enum vb2_buffer_state state)
+{
+	struct vin_buffer *buf, *tmp;
+	unsigned long flags;
+
+	spin_lock_irqsave(&ch->qlock, flags);
+	if (ch->active && !ch->active_done)
+		vb2_buffer_done(&ch->active->vb.vb2_buf, state);
+	if (ch->queued && ch->queued != ch->active)
+		vb2_buffer_done(&ch->queued->vb.vb2_buf, state);
+	ch->active = ch->queued = NULL;
+	list_for_each_entry_safe(buf, tmp, &ch->pending, list) {
+		list_del(&buf->list);
+		vb2_buffer_done(&buf->vb.vb2_buf, state);
+	}
+	spin_unlock_irqrestore(&ch->qlock, flags);
+}
+
+/* shared part: clocks, MIPI, sensor, ISP; parser last (starts the data) */
+static int vin_pipe_start(struct vin_dev *vin, struct vin_chan *first)
+{
+	int ret;
+
+	ret = clk_bulk_prepare_enable(vin->num_clks, vin->clks);
+	if (ret)
+		return ret;
+	ret = reset_control_deassert(vin->reset);
+	if (ret)
+		goto err_clk;
+
+	vin->n_isp_finish = vin->n_isp_load = vin->n_isp_err = 0;
+	vin->isp_err_last = 0;
+	vin->pipe_isp = first->use_isp;
+
+	vin_hw_ccu_top_on(vin);
+	vin_hw_mipi_on(vin);
+	usleep_range(100, 200);
+
+	/* GalaxyCore sensors: MIPI receiver before the sensor */
+	ret = v4l2_subdev_enable_streams(vin->sensor, vin->sensor_pad, BIT(0));
+	if (ret) {
+		dev_err(vin->dev, "sensor stream on failed: %d\n", ret);
+		goto err_hw;
+	}
+	usleep_range(100, 200);
+
+	if (vin->pipe_isp)
+		vin_hw_isp_on(vin);
+	return 0;
+
+err_hw:
+	vin_hw_mipi_off(vin);
+	vin_hw_ccu_top_off(vin);
+	reset_control_assert(vin->reset);
+err_clk:
+	clk_bulk_disable_unprepare(vin->num_clks, vin->clks);
+	return ret;
+}
+
+static void vin_pipe_stop(struct vin_dev *vin)
+{
+	if (vin->pipe_isp) {
+		vin_clr(vin->top, TOP_EN, TOP_ISP_BRIDGE_EN);
+		vin_hw_isp_off(vin);
+	}
+	v4l2_subdev_disable_streams(vin->sensor, vin->sensor_pad, BIT(0));
+	vin_hw_parser_off(vin);
+	vin_hw_mipi_off(vin);
+	vin_hw_ccu_top_off(vin);
+
+	reset_control_assert(vin->reset);
+	clk_bulk_disable_unprepare(vin->num_clks, vin->clks);
+}
+
+static int vin_start_streaming(struct vb2_queue *q, unsigned int count)
+{
+	struct vin_chan *ch = vb2_get_drv_priv(q);
+	struct vin_dev *vin = ch->vin;
+	unsigned long flags;
+	bool first;
+	int ret = 0;
+
+	if (!vin->sensor) {
+		ret = -ENODEV;
+		goto err_return;
+	}
+
+	mutex_lock(&vin->pipe_lock);
+	first = !vin->nstreaming;
+	/* raw capture bypasses the ISP: it cannot share the pipeline */
+	if (!first && (!ch->use_isp || !vin->pipe_isp)) {
+		ret = -EBUSY;
+		goto err_unlock;
+	}
+
+	ch->sequence = 0;
+	ch->irq_vs = ch->irq_fd = ch->irq_overflow = 0;
+	ch->frames_dropped = 0;
+
+	spin_lock_irqsave(&ch->qlock, flags);
+	ch->active = NULL;
+	ch->active_done = false;
+	ch->queued = vin_pop_pending(ch);
+	spin_unlock_irqrestore(&ch->qlock, flags);
+
+	if (first) {
+		ret = vin_pipe_start(vin, ch);
+		if (ret)
+			goto err_unlock;
+	}
+
+	/* a joining channel is picked up at the next frame start */
+	if (ch->use_isp)
+		vin_hw_vipp_on(ch);
+	vin_hw_dma_on(ch);
+	vin_hw_set_addr(ch, ch->queued);
+	ch->streaming = true;
+	vin->nstreaming++;
+
+	if (first) {
+		usleep_range(100, 200);
+		vin_hw_parser_on(vin);
+	}
+	mutex_unlock(&vin->pipe_lock);
+	return 0;
+
+err_unlock:
+	mutex_unlock(&vin->pipe_lock);
+err_return:
+	vin_return_all(ch, VB2_BUF_STATE_QUEUED);
+	return ret;
+}
+
+static void vin_stop_streaming(struct vb2_queue *q)
+{
+	struct vin_chan *ch = vb2_get_drv_priv(q);
+	struct vin_dev *vin = ch->vin;
+
+	vin_dump_status(ch, "stop");
+
+	mutex_lock(&vin->pipe_lock);
+	vin_hw_dma_off(ch);
+	if (ch->use_isp)
+		vin_hw_vipp_off(ch);
+	ch->streaming = false;
+	if (!--vin->nstreaming)
+		vin_pipe_stop(vin);
+	mutex_unlock(&vin->pipe_lock);
+
+	vin_return_all(ch, VB2_BUF_STATE_ERROR);
+}
+
+static const struct vb2_ops vin_vb2_ops = {
+	.queue_setup = vin_queue_setup,
+	.buf_prepare = vin_buf_prepare,
+	.buf_queue = vin_buf_queue,
+	.start_streaming = vin_start_streaming,
+	.stop_streaming = vin_stop_streaming,
+};
