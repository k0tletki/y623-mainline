+/* ISP load image layout */
+#define ISP_IMG_UPDATE		0x020	/* table update flags read by driver */
+#define ISP_IMG_MODULE_EN	0x1a0
+#define  ISP_MOD_WDR_EN		BIT(2)
+#define  ISP_MOD_D3D_EN		BIT(5)
+#define  ISP_MOD_SRC0_EN	BIT(31)
+#define  ISP_MOD_WB_EN		BIT(7)
+#define  ISP_MOD_BLC_EN		BIT(18)
+#define  ISP_MOD_DG_EN		BIT(19)
+/*
+ * Load-image words found by experiment (white ceiling as reference):
+ *  WB gains R|Gr<<16, Gb|B<<16, 0x100 = 1.0 (module bit 7)
+ *  DG gains same layout at 0x360/0x364, 0x400 = 1.0 (module bit 19)
+ *  BLC offsets, 13-bit signed, added, 12-bit scale (module bit 18)
+ */
+#define ISP_IMG_DG_GAIN0	0x360
+#define ISP_IMG_DG_GAIN1	0x364
+#define ISP_IMG_WB_GAIN0	0x370
+#define ISP_IMG_WB_GAIN1	0x374
+#define ISP_IMG_BLC_OFF0	0x1ec
+#define ISP_IMG_BLC_OFF1	0x1f0
+#define ISP_MOD_GAMMA_EN	BIT(9)
+/* gamma table in the load image's RGB table area: 1024 x (R | G<<10 | B<<20), 10 bit */
+#define ISP_IMG_GAMMA_TBL	0x7e40
+#define ISP_IMG_RGB_TBL_END	0x9740	/* RGB table area 0x7b40 + 0x1c00 */
+#define ISP_UPDATE_GAMMA	BIT(3)
+#define ISP_MOD_RGB2RGB_EN	BIT(12)
+/* RGB2RGB: 9 x 12-bit gains (256 = 1.0), two per word, then 13-bit offsets */
+#define ISP_IMG_RGB2RGB_GAIN0	0x440
+#define ISP_IMG_RGB2RGB_OFFSET	0x454
+/*
+ * GC3003 colour matrices, three colour temperatures. Rows sum to 256.
+ *
+ * NOTICE: matrices 1..3 are calibration data taken from the GC3003 ISP tuning
+ * set ("gc3003_20fps_ipc_day_20230308") of the camera's stock firmware. They
+ * are included only as functional data (numbers describing this sensor's
+ * colour response) so the image has correct colours; no vendor code or other
+ * vendor data is part of this driver. Use ccm=0 to run without them.
+ */
+static const s16 vin_ccm_gc3003[4][9] = {
+	{ 407,  -92,  -59, -137, 481,  -88, -113, -595, 964 },
+	{ 434, -156,  -22, -112, 421,  -53,  -66, -381, 703 },
+	{ 444, -185,   -3,  -74, 433, -103,  -25, -277, 558 },
+	/* 4: monochrome (IR night mode): every channel = equal-weight luma */
+	{  85,   86,   85,   85,  86,   85,   85,   86,  85 },
+};
+
+/* gamma: 0 = off (linear), 1 = identity (test), 2 = sRGB, 3 = BT.709 + mild S-curve */
+static unsigned int gamma_mode = 3;
+/* input black point crushed before the gamma curve, in 1/1000 of full scale */
+static unsigned int gamma_black = 60;
+/* colour matrix: 0 = off, 1..3 = GC3003 stock matrices, 4 = monochrome (IR) */
+static unsigned int ccm = 3;
+static void vin_gamma_apply(void *img)
+{
+	u32 *t = img + ISP_IMG_GAMMA_TBL;
+	u32 mods = *(u32 *)(img + 0x1a0), upd = *(u32 *)(img + 0x020);
+	unsigned int i;
+
+	if (!gamma_mode) {
+		*(u32 *)(img + 0x1a0) = mods & ~ISP_MOD_GAMMA_EN;
+		*(u32 *)(img + 0x020) = upd & ~ISP_UPDATE_GAMMA;
+		return;
+	}
+	for (i = 0; i < 1024; i++) {
+		int b = min(gamma_black, 500u) * 1023 / 1000;
+		int j = clamp_t(int, (i - b) * 1023 / (1023 - b), 0, 1023);
+		u32 v = gamma_mode == 1 ? i : gamma_mode == 2 ? vin_gamma_srgb[j] :
+			vin_gamma_709s[j];
+
+		t[i] = v | v << 10 | v << 20;
+	}
+	/*
+	 * After WB gains the brightest pixels index past entry 1023 (into the
+	 * rest of the RGB table area); clamp them to white instead of reading
+	 * zeros (seen as cyan/green blotches in highlights).
+	 */
+	for (; i < (ISP_IMG_RGB_TBL_END - ISP_IMG_GAMMA_TBL) / 4; i++)
+		t[i] = 0x3fffffff;
+	*(u32 *)(img + 0x020) = upd | ISP_UPDATE_GAMMA;
+	*(u32 *)(img + 0x1a0) = mods | ISP_MOD_GAMMA_EN;
+}
+static int vin_gamma_set(const char *val, const struct kernel_param *kp)
+{
+	int ret = param_set_uint(val, kp);
+
+	if (!ret && vin_isp_load_live)
+		vin_gamma_apply(vin_isp_load_live);
+	return ret;
+}
