+static inline void vin_set(void __iomem *base, u32 reg, u32 bits)
+{
+	writel(readl(base + reg) | bits, base + reg);
+}
+
+static inline void vin_clr(void __iomem *base, u32 reg, u32 bits)
+{
+	writel(readl(base + reg) & ~bits, base + reg);
+}
+
+static inline void vin_img_write(void *img, u32 off, u32 val)
+{
+	WRITE_ONCE(*(u32 *)(img + off), val);
+}
+
+static inline u32 vin_img_read(void *img, u32 off)
+{
+	return READ_ONCE(*(u32 *)(img + off));
+}
