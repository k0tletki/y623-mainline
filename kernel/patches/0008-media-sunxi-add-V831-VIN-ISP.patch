+static void vin_mipi_test_write(struct vin_dev *vin, u32 code, u32 data)
+{
+	vin_set(vin->mipi, MIPI_TEST_CTL, BIT(28));
+	vin_set(vin->mipi, MIPI_TEST_CTL, BIT(16));
+	writel(code << 16, vin->mipi + MIPI_TEST_DATA);
+	vin_clr(vin->mipi, MIPI_TEST_CTL, BIT(16));
+	vin_clr(vin->mipi, MIPI_TEST_CTL, BIT(28));
+	writel(data << 16, vin->mipi + MIPI_TEST_DATA);
+	vin_set(vin->mipi, MIPI_TEST_CTL, BIT(16));
+	vin_clr(vin->mipi, MIPI_TEST_CTL, BIT(16));
+}
+
+/* Undocumented values; identical to the vendor driver for every data rate. */
+static void vin_hw_mipi_on(struct vin_dev *vin)
+{
+	static const struct { u16 reg; u32 val; } defaults[] = {
+		{ 0x004, 0xb8c39bec }, { 0x008, 0xb8d257f8 },
+		{ 0x010, 0xb8df698e }, { 0x018, 0xb8c8a30c },
+		{ 0x01c, 0xb8df8ad7 },
+	};
+	static const u16 zeroed[] = {
+		0x028, 0x02c, 0x030, 0x008, 0x104, 0x10c, 0x110,
+	};
+	static const u32 dphy_init[] = {
+		0x00000000, 0x00000000, 0x00000100, 0x00000100,
+		0x00000100, 0x00000100, 0x80000100, 0x80008100, 0x80008000,
+	};
+	void __iomem *m = vin->mipi;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(defaults); i++) {
+		writel(0, m + defaults[i].reg);
+		writel(defaults[i].val, m + defaults[i].reg);
+	}
+	for (i = 0; i < ARRAY_SIZE(zeroed); i++)
+		writel(0, m + zeroed[i]);
+	writel(0, m + MIPI_PROTO_CTL);
+	writel(0xb8c64f24, m + MIPI_PROTO_CTL);
+
+	for (i = 0; i < ARRAY_SIZE(dphy_init); i++)
+		writel(dphy_init[i], m + MIPI_DPHY);
+	writel(0xa0200000, m + 0x030);
+
+	writel(0x80000000, m + 0x004);
+	writel(0x12200000, m + MIPI_PROTO_CTL);
+
+	vin_mipi_test_write(vin, 0x75, 0xa0);
+
+	vin_set(m, MIPI_PROTO_CTL, FIELD_PREP(MIPI_LANES, vin->lanes - 1));
+	/* one channel (ch_num - 1 = 0), VC 0 */
+	vin_set(m, MIPI_PKT_CH0, vin->sensor_fmt->mipi_dt);
+
+	vin_set(m, MIPI_DPHY, 0x3);
+	vin_set(m, MIPI_PROTO_CTL, MIPI_PROTO_EN);
+}
+
+static void vin_hw_mipi_off(struct vin_dev *vin)
+{
+	vin_clr(vin->mipi, MIPI_PROTO_CTL, MIPI_PROTO_EN);
+}
+
+static void vin_hw_parser_on(struct vin_dev *vin)
+{
+	void __iomem *p = vin->prs;
+
+	vin_set(p, PRS_EN, PRS_EN_PCLK_EN);
+	vin_set(p, PRS_EN, PRS_EN_PRS_EN);
+	vin_clr(p, PRS_EN, PRS_EN_PRS_EN);
+	vin_set(p, PRS_EN, PRS_EN_PRS_EN);
+	vin_set(p, PRS_EN, PRS_EN_MODE_MCSI);
+	writel(0, p + PRS_MCSI_IF_CFG);		/* progressive, field mode */
+	vin_set(p, PRS_EN, PRS_EN_MCSI_EN);
+	writel(0, p + PRS_CH0_INFMT);		/* raw */
+	writel(FIELD_PREP(PRS_LEN, vin->in_width), p + PRS_CH0_HSIZE);
+	writel(FIELD_PREP(PRS_LEN, vin->in_height), p + PRS_CH0_VSIZE);
+	writel(PRS_CAP_CH0_VCAP, p + PRS_CAP);	/* video capture, no fps ds */
+}
+
+static void vin_hw_parser_off(struct vin_dev *vin)
+{
+	writel(0, vin->prs + PRS_CAP);
+	vin_clr(vin->prs, PRS_EN, PRS_EN_MCSI_EN | PRS_EN_PCLK_EN);
+	vin_clr(vin->prs, PRS_EN, PRS_EN_PRS_EN);
+}
