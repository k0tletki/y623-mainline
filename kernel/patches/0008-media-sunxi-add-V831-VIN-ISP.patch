+/* ------------------------------------------------------------------------
+ * Sensor binding
+ */
+
+static int vin_update_format(struct vin_dev *vin)
+{
+	struct v4l2_subdev_format sfmt = {
+		.which = V4L2_SUBDEV_FORMAT_ACTIVE,
+		.pad = vin->sensor_pad,
+	};
+	unsigned int i;
+	int ret;
+
+	ret = v4l2_subdev_call_state_active(vin->sensor, pad, get_fmt, &sfmt);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < ARRAY_SIZE(vin_formats); i++)
+		if (vin_formats[i].mbus_code == sfmt.format.code)
+			break;
+	if (i == ARRAY_SIZE(vin_formats)) {
+		dev_err(vin->dev, "unsupported sensor format 0x%04x\n",
+			sfmt.format.code);
+		return -EINVAL;
+	}
+	vin->sensor_fmt = &vin_formats[i];
+	vin->in_width = sfmt.format.width;
+	vin->in_height = sfmt.format.height;
+
+	/* channel 0 default: raw at native size (the proven path) */
+	vin->chan[0].fmt.pixelformat = vin->sensor_fmt->fourcc;
+	vin_fill_pix(vin, &vin->chan[0].fmt);
+	vin->chan[0].use_isp = false;
+	/* channel 1: NV12 sub-stream, 640x360 by default */
+	if (vin->nchan > 1) {
+		struct v4l2_pix_format *pix = &vin->chan[1].fmt;
+
+		pix->pixelformat = V4L2_PIX_FMT_NV12;
+		pix->width = 640;
+		pix->height = 360;
+		vin_fill_pix(vin, pix);
+		vin->chan[1].use_isp = true;
+	}
+
+	dev_info(vin->dev, "sensor %s: %ux%u code 0x%04x, %u lanes\n",
+		 vin->sensor->name, vin->in_width, vin->in_height,
+		 sfmt.format.code, vin->lanes);
+	return 0;
+}
+
+static int vin_notify_bound(struct v4l2_async_notifier *notifier,
+			    struct v4l2_subdev *sd,
+			    struct v4l2_async_connection *asc)
+{
+	struct vin_dev *vin = container_of(notifier, struct vin_dev, notifier);
+	unsigned int i;
+	int pad, ret;
+
+	pad = media_entity_get_fwnode_pad(&sd->entity, asc->match.fwnode,
+					  MEDIA_PAD_FL_SOURCE);
+	if (pad < 0)
+		pad = 0;
+
+	vin->sensor = sd;
+	vin->sensor_pad = pad;
+
+	for (i = 0; i < vin->nchan; i++) {
+		ret = media_create_pad_link(&sd->entity, pad,
+					    &vin->chan[i].vdev.entity, 0,
+					    MEDIA_LNK_FL_ENABLED |
+					    MEDIA_LNK_FL_IMMUTABLE);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int vin_notify_complete(struct v4l2_async_notifier *notifier)
+{
+	struct vin_dev *vin = container_of(notifier, struct vin_dev, notifier);
+	int ret;
+
+	ret = vin_update_format(vin);
+	if (ret)
+		return ret;
+
+	return v4l2_device_register_subdev_nodes(&vin->v4l2_dev);
+}
+
+static const struct v4l2_async_notifier_operations vin_notify_ops = {
+	.bound = vin_notify_bound,
+	.complete = vin_notify_complete,
+};
+
+static int vin_parse_dt(struct vin_dev *vin)
+{
+	struct v4l2_fwnode_endpoint vep = { .bus_type = V4L2_MBUS_CSI2_DPHY };
+	struct v4l2_async_connection *asc;
+	struct fwnode_handle *ep;
+	int ret;
+
+	ep = fwnode_graph_get_endpoint_by_id(dev_fwnode(vin->dev), 0, 0, 0);
+	if (!ep)
+		return dev_err_probe(vin->dev, -ENODEV, "no endpoint\n");
+
+	ret = v4l2_fwnode_endpoint_parse(ep, &vep);
+	if (ret) {
+		fwnode_handle_put(ep);
+		return dev_err_probe(vin->dev, ret, "bad endpoint\n");
+	}
+	vin->lanes = vep.bus.mipi_csi2.num_data_lanes;
+	if (vin->lanes < 1 || vin->lanes > 4) {
+		fwnode_handle_put(ep);
+		return dev_err_probe(vin->dev, -EINVAL, "bad lane count\n");
+	}
+
+	asc = v4l2_async_nf_add_fwnode_remote(&vin->notifier, ep,
+					      struct v4l2_async_connection);
+	fwnode_handle_put(ep);
+	return PTR_ERR_OR_ZERO(asc);
+}
+
+/* ------------------------------------------------------------------------
+ * Probe
+ */
+
+static int vin_chan_init(struct vin_dev *vin, struct platform_device *pdev,
+			 unsigned int id)
+{
+	struct device *dev = vin->dev;
+	struct vin_chan *ch = &vin->chan[id];
+	struct vb2_queue *q = &ch->queue;
+	char name[8];
+	int irq, ret;
+
+	ch->vin = vin;
+	ch->id = id;
+	mutex_init(&ch->lock);
+	spin_lock_init(&ch->qlock);
+	INIT_LIST_HEAD(&ch->pending);
+
+	snprintf(name, sizeof(name), id ? "vipp%u" : "vipp", id);
+	ch->vipp = devm_platform_ioremap_resource_byname(pdev, name);
+	if (IS_ERR(ch->vipp))
+		return PTR_ERR(ch->vipp);
+	snprintf(name, sizeof(name), id ? "dma%u" : "dma", id);
+	ch->dma = devm_platform_ioremap_resource_byname(pdev, name);
+	if (IS_ERR(ch->dma))
+		return PTR_ERR(ch->dma);
+
+	/* VIPP image + the (unused) OSD stat area right after it */
+	ch->vipp_load = dmam_alloc_coherent(dev, 2 * VIPP_IMG_SIZE,
+					    &ch->vipp_load_dma, GFP_KERNEL);
+	if (!ch->vipp_load)
+		return -ENOMEM;
+
+	irq = platform_get_irq_byname(pdev, name);
+	if (irq < 0)
+		return irq;
+	ret = devm_request_irq(dev, irq, vin_dma_irq, 0,
+			       id ? VIN_NAME "-dma1" : VIN_NAME, ch);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to request %s irq\n", name);
+
+	q->type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+	q->io_modes = VB2_MMAP | VB2_DMABUF;
+	q->drv_priv = ch;
+	q->buf_struct_size = sizeof(struct vin_buffer);
+	q->ops = &vin_vb2_ops;
+	q->mem_ops = &vb2_dma_contig_memops;
+	/*
+	 * REQBUFS may ask for V4L2_MEMORY_FLAG_NON_COHERENT: cached CPU mappings
+	 * with cache maintenance at QBUF/DQBUF. camrtsp uses it for the
+	 * sub-stream it reads for the person detector (uncached reads under
+	 * ISP/VE/EISE load ran at ~4 MB/s).
+	 */
+	q->allow_cache_hints = 1;
+	q->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_MONOTONIC |
+			     V4L2_BUF_FLAG_TSTAMP_SRC_SOE;
+	q->min_queued_buffers = VIN_MIN_BUFFERS;
+	q->lock = &ch->lock;
+	q->dev = dev;
+	ret = vb2_queue_init(q);
+	if (ret)
+		return ret;
+
+	snprintf(ch->vdev.name, sizeof(ch->vdev.name), "%s%s", VIN_NAME,
+		 id ? "-sub" : "");
+	ch->vdev.fops = &vin_fops;
+	ch->vdev.ioctl_ops = &vin_ioctl_ops;
+	ch->vdev.v4l2_dev = &vin->v4l2_dev;
+	ch->vdev.queue = q;
+	ch->vdev.lock = &ch->lock;
+	ch->vdev.release = video_device_release_empty;
+	ch->vdev.device_caps = V4L2_CAP_VIDEO_CAPTURE | V4L2_CAP_STREAMING;
+	ch->vdev.vfl_dir = VFL_DIR_RX;
+	video_set_drvdata(&ch->vdev, ch);
+
+	ch->vdev_pad.flags = MEDIA_PAD_FL_SINK;
+	return media_entity_pads_init(&ch->vdev.entity, 1, &ch->vdev_pad);
+}
+
+static int vin_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct vin_dev *vin;
+	unsigned int i, nreg = 0;
+	int irq, ret;
+
+	vin = devm_kzalloc(dev, sizeof(*vin), GFP_KERNEL);
+	if (!vin)
+		return -ENOMEM;
+	vin->dev = dev;
+	mutex_init(&vin->pipe_lock);
+
+#define MAP(field, name)						\
+	do {								\
+		vin->field = devm_platform_ioremap_resource_byname(pdev, name); \
+		if (IS_ERR(vin->field))					\
+			return PTR_ERR(vin->field);			\
+	} while (0)
+	MAP(ccu, "ccu");
+	MAP(top, "top");
+	MAP(prs, "parser");
+	MAP(mipi, "mipi");
+	MAP(isp, "isp");
+#undef MAP
+
+	/* optional dedicated frame-buffer pool */
+	ret = of_reserved_mem_device_init(dev);
+	if (ret && ret != -ENODEV)
+		return dev_err_probe(dev, ret, "failed to init memory pool\n");
+
+	ret = devm_clk_bulk_get_all(dev, &vin->clks);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "failed to get clocks\n");
+	vin->num_clks = ret;
+
+	vin->reset = devm_reset_control_get_exclusive(dev, NULL);
+	if (IS_ERR(vin->reset))
+		return dev_err_probe(dev, PTR_ERR(vin->reset),
+				     "failed to get reset\n");
+
+	vin->isp_load = dmam_alloc_coherent(dev, ISP_LOAD_DRAM_SIZE,
+					    &vin->isp_load_dma, GFP_KERNEL);
+	vin->isp_save = dmam_alloc_coherent(dev, ISP_SAVE_DRAM_SIZE,
+					    &vin->isp_save_dma, GFP_KERNEL);
+	if (!vin->isp_load || !vin->isp_save)
+		return -ENOMEM;
+
+	irq = platform_get_irq_byname(pdev, "isp");
+	if (irq < 0)
+		return irq;
+	ret = devm_request_irq(dev, irq, vin_isp_irq, 0, VIN_NAME "-isp", vin);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to request isp irq\n");
+
+	/* placeholder until the sensor binds */
+	vin->sensor_fmt = &vin_formats[0];
+
+	vin->mdev.dev = dev;
+	strscpy(vin->mdev.model, "Allwinner V831 VIN", sizeof(vin->mdev.model));
+	media_device_init(&vin->mdev);
+	vin->v4l2_dev.mdev = &vin->mdev;
+
+	ret = v4l2_device_register(dev, &vin->v4l2_dev);
+	if (ret)
+		goto err_media;
+
+	/* channel 1 only when the DT describes its VIPP/DMA */
+	vin->nchan = platform_get_resource_byname(pdev, IORESOURCE_MEM, "dma1") ?
+		     2 : 1;
+	for (i = 0; i < vin->nchan; i++) {
+		ret = vin_chan_init(vin, pdev, i);
+		if (ret)
+			goto err_entity;
+	}
+
+	ret = media_device_register(&vin->mdev);
+	if (ret)
+		goto err_entity;
+
+	/*
+	 * Register the video nodes (and with them the media entities) before
+	 * the sensor can bind: the bound callback links the sensor to these
+	 * entities, which must already belong to the media device.
+	 */
+	for (nreg = 0; nreg < vin->nchan; nreg++) {
+		ret = video_register_device(&vin->chan[nreg].vdev,
+					    VFL_TYPE_VIDEO, -1);
+		if (ret)
+			goto err_vdev;
+		dev_info(dev, "registered %s (channel %u)\n",
+			 video_device_node_name(&vin->chan[nreg].vdev), nreg);
+	}
+
+	v4l2_async_nf_init(&vin->notifier, &vin->v4l2_dev);
+	vin->notifier.ops = &vin_notify_ops;
+	ret = vin_parse_dt(vin);
+	if (ret)
+		goto err_nf;
+	ret = v4l2_async_nf_register(&vin->notifier);
+	if (ret)
+		goto err_nf;
+
+	platform_set_drvdata(pdev, vin);
+	return 0;
+
+err_nf:
+	v4l2_async_nf_cleanup(&vin->notifier);
+err_vdev:
+	while (nreg--)
+		vb2_video_unregister_device(&vin->chan[nreg].vdev);
+	media_device_unregister(&vin->mdev);
+err_entity:
+	for (i = 0; i < vin->nchan; i++)
+		media_entity_cleanup(&vin->chan[i].vdev.entity);
+	v4l2_device_unregister(&vin->v4l2_dev);
+err_media:
+	media_device_cleanup(&vin->mdev);
+	return ret;
+}
+
+static void vin_remove(struct platform_device *pdev)
+{
+	struct vin_dev *vin = platform_get_drvdata(pdev);
+	unsigned int i;
+
+	v4l2_async_nf_unregister(&vin->notifier);
+	v4l2_async_nf_cleanup(&vin->notifier);
+	for (i = 0; i < vin->nchan; i++)
+		vb2_video_unregister_device(&vin->chan[i].vdev);
+	media_device_unregister(&vin->mdev);
+	for (i = 0; i < vin->nchan; i++)
+		media_entity_cleanup(&vin->chan[i].vdev.entity);
+	v4l2_device_unregister(&vin->v4l2_dev);
+	media_device_cleanup(&vin->mdev);
+	of_reserved_mem_device_release(&pdev->dev);
+}
+
+static const struct of_device_id vin_of_match[] = {
+	{ .compatible = "allwinner,sun8i-v831-vin" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, vin_of_match);
+
+static struct platform_driver vin_driver = {
+	.probe = vin_probe,
+	.remove = vin_remove,
+	.driver = {
+		.name = VIN_NAME,
+		.of_match_table = vin_of_match,
+	},
+};
+module_platform_driver(vin_driver);
+
+MODULE_DESCRIPTION("Allwinner V831 video input (MIPI CSI-2, ISP521, VIPP)");
+MODULE_LICENSE("GPL");
