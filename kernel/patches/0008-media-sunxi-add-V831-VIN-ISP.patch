+/* ------------------------------------------------------------------------
+ * V4L2
+ */
+
+static void vin_fill_pix(struct vin_dev *vin, struct v4l2_pix_format *pix)
+{
+	if (pix->pixelformat == V4L2_PIX_FMT_NV12) {
+		/* VIPP: no upscaling, at most 16x down, width multiple of 16 */
+		pix->width = clamp_t(u32, ALIGN_DOWN(pix->width, 16),
+				     max_t(u32, VIN_MIN_WIDTH,
+					   ALIGN(vin->in_width / 16, 16)),
+				     ALIGN_DOWN(vin->in_width, 16));
+		pix->height = clamp_t(u32, ALIGN_DOWN(pix->height, 2),
+				      max_t(u32, VIN_MIN_HEIGHT,
+					    ALIGN(vin->in_height / 16, 2)),
+				      vin->in_height);
+		pix->bytesperline = pix->width;
+		/*
+		 * Chroma follows 'height' luma lines; pad to whole 16-line
+		 * rows so a macroblock-based consumer (the VE encoder) can
+		 * import the buffer directly.
+		 */
+		pix->sizeimage = pix->width * ALIGN(pix->height, 16) * 3 / 2;
+		pix->colorspace = V4L2_COLORSPACE_SRGB;
+		pix->ycbcr_enc = V4L2_YCBCR_ENC_601;
+		pix->quantization = V4L2_QUANTIZATION_LIM_RANGE;
+		pix->xfer_func = V4L2_XFER_FUNC_SRGB;
+	} else {
+		/* raw: native sensor size and order only */
+		pix->pixelformat = vin->sensor_fmt->fourcc;
+		pix->width = vin->in_width;
+		pix->height = vin->in_height;
+		/* raw 10/12 bit is stored in 16-bit containers */
+		pix->bytesperline = pix->width * 2;
+		pix->sizeimage = pix->bytesperline * pix->height;
+		pix->colorspace = V4L2_COLORSPACE_RAW;
+		pix->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+		pix->quantization = V4L2_QUANTIZATION_DEFAULT;
+		pix->xfer_func = V4L2_XFER_FUNC_NONE;
+	}
+	pix->field = V4L2_FIELD_NONE;
+}
+
+static int vin_querycap(struct file *file, void *priv,
+			struct v4l2_capability *cap)
+{
+	strscpy(cap->driver, VIN_NAME, sizeof(cap->driver));
+	strscpy(cap->card, "Allwinner V831 VIN", sizeof(cap->card));
+	return 0;
+}
+
+static int vin_enum_fmt(struct file *file, void *priv,
+			struct v4l2_fmtdesc *f)
+{
+	struct vin_chan *ch = video_drvdata(file);
+
+	switch (f->index) {
+	case 0:
+		f->pixelformat = V4L2_PIX_FMT_NV12;
+		return 0;
+	case 1:
+		if (ch->id)	/* raw only on channel 0 */
+			break;
+		f->pixelformat = ch->vin->sensor_fmt->fourcc;
+		return 0;
+	}
+	return -EINVAL;
+}
+
+static int vin_g_fmt(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct vin_chan *ch = video_drvdata(file);
+
+	f->fmt.pix = ch->fmt;
+	return 0;
+}
+
+static void vin_chan_fill_pix(struct vin_chan *ch, struct v4l2_pix_format *pix)
+{
+	if (ch->id)
+		pix->pixelformat = V4L2_PIX_FMT_NV12;
+	vin_fill_pix(ch->vin, pix);
+}
+
+static int vin_try_fmt(struct file *file, void *priv, struct v4l2_format *f)
+{
+	vin_chan_fill_pix(video_drvdata(file), &f->fmt.pix);
+	return 0;
+}
+
+static int vin_s_fmt(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct vin_chan *ch = video_drvdata(file);
+
+	if (vb2_is_busy(&ch->queue))
+		return -EBUSY;
+
+	vin_chan_fill_pix(ch, &f->fmt.pix);
+	ch->fmt = f->fmt.pix;
+	ch->use_isp = ch->fmt.pixelformat == V4L2_PIX_FMT_NV12;
+	return 0;
+}
+
+static int vin_enum_framesizes(struct file *file, void *priv,
+			       struct v4l2_frmsizeenum *fs)
+{
+	struct vin_chan *ch = video_drvdata(file);
+	struct vin_dev *vin = ch->vin;
+
+	if (fs->index)
+		return -EINVAL;
+
+	if (fs->pixel_format == V4L2_PIX_FMT_NV12) {
+		fs->type = V4L2_FRMSIZE_TYPE_STEPWISE;
+		fs->stepwise.min_width = max_t(u32, VIN_MIN_WIDTH,
+					       ALIGN(vin->in_width / 16, 16));
+		fs->stepwise.max_width = ALIGN_DOWN(vin->in_width, 16);
+		fs->stepwise.step_width = 16;
+		fs->stepwise.min_height = max_t(u32, VIN_MIN_HEIGHT,
+						ALIGN(vin->in_height / 16, 2));
+		fs->stepwise.max_height = vin->in_height;
+		fs->stepwise.step_height = 2;
+		return 0;
+	}
+	if (ch->id || fs->pixel_format != vin->sensor_fmt->fourcc)
+		return -EINVAL;
+	fs->type = V4L2_FRMSIZE_TYPE_DISCRETE;
+	fs->discrete.width = vin->in_width;
+	fs->discrete.height = vin->in_height;
+	return 0;
+}
+
+static int vin_enum_input(struct file *file, void *priv,
+			  struct v4l2_input *inp)
+{
+	if (inp->index)
+		return -EINVAL;
+	inp->type = V4L2_INPUT_TYPE_CAMERA;
+	strscpy(inp->name, "Camera", sizeof(inp->name));
+	return 0;
+}
+
+static int vin_g_input(struct file *file, void *priv, unsigned int *i)
+{
+	*i = 0;
+	return 0;
+}
+
+static int vin_s_input(struct file *file, void *priv, unsigned int i)
+{
+	return i ? -EINVAL : 0;
+}
