Subject: [PATCH] media: sunxi: add V831 VIN (CSI + ISP521 + scaler) driver

Capture driver for the V831 video input: parallel/MIPI CSI, the ISP521 pipeline
(defaults and gamma tables from the GPL-2.0 Allwinner sunxi-vin sources) and
the main/sub-stream scalers.

---
 .../media/platform/sunxi/sun8i-v831-vin/Kconfig   |   14 +
 .../media/platform/sunxi/sun8i-v831-vin/Makefile  |    1 +
 .../sunxi/sun8i-v831-vin/isp521_default.h         |  270 +++
 .../platform/sunxi/sun8i-v831-vin/isp521_gamma.h  |  137 ++
 .../sunxi/sun8i-v831-vin/sun8i_v831_vin.c         | 1805 +++++++++++++++++++
 5 files changed, 2227 insertions(+)

diff --git a/drivers/media/platform/sunxi/sun8i-v831-vin/Kconfig b/drivers/media/platform/sunxi/sun8i-v831-vin/Kconfig
new file mode 100644
index 0000000000000000000000000000000000000000..95fec7545b7b35cb38009fb11b9d0b458fa04187
--- /dev/null
+++ b/drivers/media/platform/sunxi/sun8i-v831-vin/Kconfig
@@ -0,0 +1,14 @@
+# SPDX-License-Identifier: GPL-2.0-only
+config VIDEO_SUN8I_V831_VIN
+	tristate "Allwinner V831/V833 video input (raw MIPI CSI-2)"
+	depends on V4L_PLATFORM_DRIVERS && VIDEO_DEV
+	depends on ARCH_SUNXI || COMPILE_TEST
+	depends on HAS_DMA && OF
+	select MEDIA_CONTROLLER
+	select VIDEO_V4L2_SUBDEV_API
+	select VIDEOBUF2_DMA_CONTIG
+	select V4L2_FWNODE
+	select RESET_CONTROLLER
+	help
+	  Raw Bayer capture from a MIPI CSI-2 sensor on the Allwinner V831
+	  and V833 (sun8iw19). The ISP is bypassed.
diff --git a/drivers/media/platform/sunxi/sun8i-v831-vin/Makefile b/drivers/media/platform/sunxi/sun8i-v831-vin/Makefile
new file mode 100644
index 0000000000000000000000000000000000000000..709898abacf6e9b81bfce63d6cd130932ac7cc26
--- /dev/null
+++ b/drivers/media/platform/sunxi/sun8i-v831-vin/Makefile
@@ -0,0 +1 @@
+obj-$(CONFIG_VIDEO_SUN8I_V831_VIN) += sun8i_v831_vin.o
diff --git a/drivers/media/platform/sunxi/sun8i-v831-vin/isp521_default.h b/drivers/media/platform/sunxi/sun8i-v831-vin/isp521_default.h
new file mode 100644
index 0000000000000000000000000000000000000000..ec55870a32c1cd92f9f922afba687d8a9f098295
--- /dev/null
