+static void vin_ccm_apply(void *img)
+{
+	u32 *w = img + ISP_IMG_RGB2RGB_GAIN0;
+	const s16 *m;
+	unsigned int i;
+
+	if (!ccm || ccm > ARRAY_SIZE(vin_ccm_gc3003)) {
+		*(u32 *)(img + 0x1a0) &= ~ISP_MOD_RGB2RGB_EN;
+		return;
+	}
+	m = vin_ccm_gc3003[ccm - 1];
+	for (i = 0; i < 4; i++)
+		w[i] = (m[2 * i] & 0xfff) | (m[2 * i + 1] & 0xfff) << 16;
+	w[4] = m[8] & 0xfff;			/* offset R = 0 */
+	*(u32 *)(img + ISP_IMG_RGB2RGB_OFFSET) = 0;	/* offsets G, B */
+	*(u32 *)(img + 0x1a0) |= ISP_MOD_RGB2RGB_EN;
+}
+static int vin_ccm_set(const char *val, const struct kernel_param *kp)
+{
+	int ret = param_set_uint(val, kp);
+
+	if (!ret && vin_isp_load_live)
+		vin_ccm_apply(vin_isp_load_live);
+	return ret;
+}
