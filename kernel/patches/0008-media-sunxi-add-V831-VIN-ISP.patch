+/* ------------------------------------------------------------------------
+ * Hardware: CCU / TOP / MIPI / parser
+ */
+
+static void vin_hw_ccu_top_on(struct vin_dev *vin)
+{
+	vin_clr(vin->ccu, CCU_MODE, CCU_CLK_GATING_DIS);
+	vin_set(vin->ccu, CCU_MODE, CCU_MCSI_CLK_MODE | CCU_POST_CLK_MODE);
+	vin_set(vin->ccu, CCU_POST0_CLK_EN, CCU_POST_CLK_EN | CCU_BK0_CLK_EN | CCU_BK1_CLK_EN |
+		CCU_VIPP0_CLK_EN | CCU_VIPP1_CLK_EN);
+	vin_set(vin->ccu, CCU_POST1_CLK_EN, CCU_POST_CLK_EN);
+	vin_set(vin->ccu, CCU_PARSER_CLK_EN, CCU_MIPI0_CLK_EN |
+		CCU_PARSER0_CLK_EN);
+	vin_set(vin->ccu, CCU_ISP_CLK_EN, CCU_MISP0_CLK_EN |
+		CCU_MISP0_BRIDGE_EN);
+
+	vin_set(vin->top, TOP_EN, TOP_ISP_BRIDGE_EN);
+	vin_set(vin->top, TOP_EN, TOP_TOP_EN);
+	writel(0x000f0f0f, vin->top + TOP_MBUS_REQ_MAX);
+	/* parser0 ch0 -> isp0 in0, isp0 ch0 -> vipp0/1 (-> dma0/1, fixed) */
+	writel(0, vin->top + TOP_ISP0_IN0);
+	writel(0, vin->top + TOP_VIPP0_IN);
+	writel(0, vin->top + TOP_VIPP0_IN + 4);
+}
+
+static void vin_hw_ccu_top_off(struct vin_dev *vin)
+{
+	writel(0, vin->top + TOP_EN);
+	writel(0, vin->ccu + CCU_ISP_CLK_EN);
+	writel(0, vin->ccu + CCU_PARSER_CLK_EN);
+	writel(0, vin->ccu + CCU_POST1_CLK_EN);
+	writel(0, vin->ccu + CCU_POST0_CLK_EN);
+	vin_set(vin->ccu, CCU_MODE, CCU_CLK_GATING_DIS);
+}
