+/* ------------------------------------------------------------------------
+ * Hardware: ISP / VIPP
+ */
+
+static void vin_isp_set_size(struct vin_dev *vin)
+{
+	u32 size = vin->in_height << 16 | vin->in_width;
+
+	writel(size, vin->isp + ISP_INPUT_SIZE);
+	writel(size, vin->isp + ISP_VALID_SIZE);
+	writel(0, vin->isp + ISP_VALID_START);
+}
+
+static void vin_hw_isp_on(struct vin_dev *vin)
+{
+	void __iomem *isp = vin->isp;
+	u32 mods, cfg0;
+
+	/* fresh load image: vendor defaults, all tables zero */
+	memset(vin->isp_load, 0, ISP_LOAD_DRAM_SIZE);
+	memcpy(vin->isp_load, isp521_default_regs, ISP_LOAD_REG_SIZE);
+	memset(vin->isp_save, 0, ISP_SAVE_DRAM_SIZE);
+
+	writel(vin->isp_save_dma >> 2, isp + ISP_SAVE_ADDR);
+	writel(vin->isp_load_dma >> 2, isp + ISP_LOAD_ADDR0);
+	writel(vin->isp_load_dma >> 2, isp + ISP_LOAD_ADDR1);
+	writel(0, isp + ISP_UPDATE);
+
+	vin_set(isp, ISP_CFG0, ISP_CFG0_EN);
+	writel(0xffffffff, isp + ISP_INT_STA);
+	writel(ISP_INT_DEFAULT, isp + ISP_INT_EN);
+
+	mods = (isp_modules | ISP_MOD_SRC0_EN) &
+	       ~(ISP_MOD_WDR_EN | ISP_MOD_D3D_EN);
+	mods |= ISP_MOD_WB_EN | ISP_MOD_BLC_EN;
+	vin_img_write(vin->isp_load, ISP_IMG_MODULE_EN, mods);
+	{
+		u32 blc = (0x2000 - black_level) & 0x1fff;
+
+		vin_img_write(vin->isp_load, ISP_IMG_BLC_OFF0, blc << 16 | blc);
+		vin_img_write(vin->isp_load, ISP_IMG_BLC_OFF1, blc << 16 | blc);
+		vin_img_write(vin->isp_load, ISP_IMG_WB_GAIN0, 0x100 << 16 | wb_red);
+		vin_img_write(vin->isp_load, ISP_IMG_WB_GAIN1, wb_blue << 16 | 0x100);
+	}
+	vin_gamma_apply(vin->isp_load);
+	vin_ccm_apply(vin->isp_load);
+	vin_isp_poke_apply(vin->isp_load);
+	vin_isp_load_live = vin->isp_load;
+	/* table update flags: none */
+	writel(vin_img_read(vin->isp_load, ISP_IMG_UPDATE) & ~(BIT(6) | BIT(7)),
+	       isp + ISP_UPDATE);
+
+	cfg0 = readl(isp + ISP_CFG0) & ~ISP_CFG0_INFMT;
+	cfg0 |= FIELD_PREP(ISP_CFG0_INFMT, vin->sensor_fmt->isp_infmt);
+	writel(cfg0, isp + ISP_CFG0);
+	vin_isp_set_size(vin);
+	vin_set(isp, ISP_UPDATE, ISP_UPDATE_PARA_READY);
+	writel(ISP_CFG1_DEFAULT, isp + ISP_CFG1);
+	writel((readl(isp + ISP_CFG3) & ~ISP_CFG3_FIFO_RAW_WR) |
+	       FIELD_PREP(ISP_CFG3_FIFO_RAW_WR, 0x200), isp + ISP_CFG3);
+	vin_set(isp, ISP_CFG0, ISP_CFG0_CH0_EN);
+	vin_set(isp, ISP_CFG0, ISP_CFG0_CAP_EN);
+
+	dev_info(vin->dev,
+		 "isp on: ver 0x%08x modules 0x%08x load @%pad save @%pad\n",
+		 readl(isp + ISP_VER), mods, &vin->isp_load_dma,
+		 &vin->isp_save_dma);
+}
+
+static void vin_hw_isp_off(struct vin_dev *vin)
+{
+	void __iomem *isp = vin->isp;
+
+	vin_isp_load_live = NULL;
+
+	vin_clr(isp, ISP_CFG0, ISP_CFG0_CAP_EN);
+	vin_img_write(vin->isp_load, ISP_IMG_MODULE_EN,
+		      vin_img_read(vin->isp_load, ISP_IMG_MODULE_EN) &
+		      ~ISP_MOD_SRC0_EN);
+	vin_clr(isp, ISP_CFG0, ISP_CFG0_CH0_EN);
+	writel(0, isp + ISP_INT_EN);
+	writel(0xffffffff, isp + ISP_INT_STA);
+	vin_clr(isp, ISP_CFG0, ISP_CFG0_EN);
+}
+
+/* weight shift for the scaler filter; ported verbatim, incl. the yr<<7 */
+static u32 vin_vipp_wshift(int x_ratio, int y_ratio)
+{
+	int xr = (x_ratio >> 8) + 1, yr = (y_ratio >> 8) + 1;
+	int m, n, sum, shift, bak = 0;
+
+	for (shift = 17; shift > 0; shift--) {
+		sum = 0;
+		for (m = 0; m <= xr; m++)
+			for (n = 0; n <= yr; n++)
+				sum += (y_ratio - abs((n << 8) - (yr << 7))) *
+				       (x_ratio - abs((m << 8) - (yr << 7))) >>
+				       (shift + 8);
+		if (sum > 0 && sum < 256)
+			bak = shift;
+		if (sum > 255 && sum < 486)
+			break;
+	}
+	return shift ? shift : bak;
+}
+
+/* Downscale ratios and centred crop, as __scaler_calc_ratios() */
+static void vin_vipp_calc(struct vin_chan *ch)
+{
+	struct vin_dev *vin = ch->vin;
+	u32 ow = ch->fmt.width, oh = ch->fmt.height;
+	u32 xr, yr, r, w, h;
+
+	xr = clamp_t(u32, 256 * vin->in_width / ow, VIPP_MIN_RATIO,
+		     VIPP_MAX_RATIO);
+	yr = clamp_t(u32, 256 * vin->in_height / oh, VIPP_MIN_RATIO,
+		     VIPP_MAX_RATIO);
+	r = min(xr, yr);
+	w = min_t(u32, ALIGN(ow * r / 256, 4), vin->in_width);
+	h = min_t(u32, ALIGN(oh * r / 256, 2), vin->in_height);
+
+	ch->xratio = clamp_t(u32, 256 * w / ow, VIPP_MIN_RATIO,
+			     VIPP_MAX_RATIO);
+	ch->yratio = clamp_t(u32, 256 * h / oh, VIPP_MIN_RATIO,
+			     VIPP_MAX_RATIO);
+	ch->wshift = vin_vipp_wshift(ch->xratio, ch->yratio);
+	ch->crop.left = ALIGN((vin->in_width - w) / 2, 4);
+	ch->crop.top = ALIGN((vin->in_height - h) / 2, 2);
+	ch->crop.width = w;
+	ch->crop.height = h;
+}
+
+static void vin_hw_vipp_on(struct vin_chan *ch)
+{
+	void __iomem *v = ch->vipp;
+	void *img = ch->vipp_load;
+
+	vin_vipp_calc(ch);
+
+	memset(img, 0, VIPP_IMG_SIZE);
+	writel(ch->vipp_load_dma >> 2, v + VIPP_REG_LOAD_ADDR);
+	/* no OSD statistics on sun8iw19: points just past the image */
+	writel((ch->vipp_load_dma + VIPP_IMG_SIZE) >> 2, v + VIPP_OSD_STAT_ADDR);
+	vin_clr(v, VIPP_CTRL, VIPP_CTRL_OV_UPDATE | VIPP_CTRL_PARA_READY);
+
+	vin_img_write(img, VIPP_IMG_CROP_START,
+		      ch->crop.top << 16 | ch->crop.left);
+	vin_img_write(img, VIPP_IMG_CROP_SIZE,
+		      ch->crop.height << 16 | ch->crop.width);
+	vin_img_write(img, VIPP_IMG_SC_CFG,
+		      FIELD_PREP(VIPP_SC_XRATIO, ch->xratio) |
+		      FIELD_PREP(VIPP_SC_YRATIO, ch->yratio) |
+		      FIELD_PREP(VIPP_SC_WSHIFT, ch->wshift));
+	vin_img_write(img, VIPP_IMG_SC_SIZE,
+		      ch->fmt.height << 16 | ch->fmt.width);
+	/* NV12: scale in 4:2:2, then chroma down-sample to 4:2:0 */
+	vin_img_write(img, VIPP_IMG_MODE, VIPP_MODE_IN_422 | VIPP_MODE_SC_422);
+	vin_img_write(img, VIPP_IMG_MODULE_EN, VIPP_MOD_SC_EN |
+		      VIPP_MOD_OSD_EN | VIPP_MOD_CHROMA_DS_EN);
+
+	vin_set(v, VIPP_CTRL, VIPP_CTRL_PARA_READY | VIPP_CTRL_OV_UPDATE);
+	vin_set(v, VIPP_TOP_EN, BIT(0));
+	vin_set(v, VIPP_EN, BIT(0));
+
+	dev_info(ch->vin->dev,
+		 "vipp%u: crop %ux%u@%u,%u -> %ux%u ratio %u/%u shift %u\n",
+		 ch->id, ch->crop.width, ch->crop.height, ch->crop.left,
+		 ch->crop.top, ch->fmt.width, ch->fmt.height,
+		 ch->xratio, ch->yratio, ch->wshift);
+}
+
+static void vin_hw_vipp_off(struct vin_chan *ch)
+{
+	vin_clr(ch->vipp, VIPP_EN, BIT(0));
+	vin_clr(ch->vipp, VIPP_TOP_EN, BIT(0));
+	vin_clr(ch->vipp, VIPP_CTRL, VIPP_CTRL_OV_UPDATE |
+		VIPP_CTRL_PARA_READY);
+	writel(readl(ch->vipp + VIPP_STA), ch->vipp + VIPP_STA);
+}
+
+/* ------------------------------------------------------------------------
+ * Hardware: DMA
+ */
+
+static void vin_hw_set_addr(struct vin_chan *ch, struct vin_buffer *buf)
+{
+	dma_addr_t addr = vb2_dma_contig_plane_dma_addr(&buf->vb.vb2_buf, 0);
+
+	writel(addr >> 2, ch->dma + DMA_F0_BUFA);
+	if (ch->use_isp)	/* NV12: UV plane right after Y */
+		writel((addr + ch->fmt.bytesperline * ch->fmt.height) >> 2,
+		       ch->dma + DMA_F1_BUFA);
+}
+
+static void vin_hw_dma_on(struct vin_chan *ch)
+{
+	void __iomem *d = ch->dma;
+	u32 w = ch->fmt.width, h = ch->fmt.height;
+	u32 bpl = ch->fmt.bytesperline;
+	u32 fmt = ch->use_isp ? DMA_FMT_NV12 : ch->vin->sensor_fmt->dma_fmt;
+
+	writel(DMA_CFG_FIELD_EITHER | FIELD_PREP(DMA_CFG_FMT, fmt),
+	       d + DMA_CFG);
+	writel(FIELD_PREP(DMA_LEN, w), d + DMA_HSIZE);
+	writel(FIELD_PREP(DMA_LEN, h), d + DMA_VSIZE);
+	writel(DMA_DMA_EN, d + DMA_EN);
+	writel(bpl << 16 | bpl, d + DMA_BUF_LEN);
+	writel(h << 16 | (ch->use_isp ? w * 2 : w), d + DMA_FLIP_SIZE);
+	vin_set(d, DMA_EN, DMA_FRAME_CNT_EN);
+	vin_set(d, DMA_EN, DMA_TOP_EN);
+	writel(0, d + DMA_F1_BUFA);
+	writel(0, d + DMA_F2_BUFA);
+	writel(DMA_INT_ALL, d + DMA_INT_STA);
+	writel(DMA_INT_VS | DMA_INT_FD | DMA_INT_OVERFLOW, d + DMA_INT_EN);
+}
+
+static void vin_hw_dma_off(struct vin_chan *ch)
+{
+	vin_clr(ch->dma, DMA_EN, DMA_TOP_EN);
+	writel(0, ch->dma + DMA_INT_EN);
+	writel(DMA_INT_ALL, ch->dma + DMA_INT_STA);
+	vin_clr(ch->dma, DMA_EN, DMA_DMA_EN);
+}
+
+static void vin_dump_status(struct vin_chan *ch, const char *when)
+{
+	struct vin_dev *vin = ch->vin;
+
+	dev_info(vin->dev,
+		 "ch%u %s: vs=%u fd=%u overflow=%u dropped=%u seq=%u frm_cnt=%u prs_in=0x%08x mipi_ctl=0x%08x isp: finish=%u load=%u err=%u (last 0x%08x) inter=0x%08x vipp_sta=0x%08x\n",
+		 ch->id, when, ch->irq_vs, ch->irq_fd, ch->irq_overflow,
+		 ch->frames_dropped, ch->sequence,
+		 readl(ch->dma + DMA_FRM_CNT) & 0xffff,
+		 readl(vin->prs + PRS_CH0_INPUT_PARA1),
+		 readl(vin->mipi + MIPI_PROTO_CTL),
+		 vin->n_isp_finish, vin->n_isp_load, vin->n_isp_err,
+		 vin->isp_err_last, readl(vin->isp + ISP_INTER_STA0),
+		 readl(ch->vipp + VIPP_STA));
+}
