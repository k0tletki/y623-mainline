+++ b/drivers/media/platform/sunxi/sun8i-cedrus-enc/cedrus_enc.c
@@ -109,11 +109,11 @@ static int cedrus_enc_format_picture_prepare(struct cedrus_context *ctx,
 
 	switch (pix_format->pixelformat) {
 	case V4L2_PIX_FMT_NV12:
-		/* Luma plane size. */
