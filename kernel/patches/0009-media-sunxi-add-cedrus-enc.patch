@@ -1,7 +1,7 @@
 # SPDX-License-Identifier: GPL-2.0
-obj-$(CONFIG_VIDEO_SUNXI_CEDRUS) += sunxi-cedrus.o
+obj-$(CONFIG_VIDEO_SUN8I_CEDRUS_ENC) += cedrus-enc.o
 
-sunxi-cedrus-y = cedrus.o \
+cedrus-enc-y = cedrus.o \
 		 cedrus_context.o \
 		 cedrus_dec.o \
 		 cedrus_dec_h264.o \
