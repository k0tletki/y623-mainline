+		}
+	}
 
 	if (status == CEDRUS_IRQ_ERROR)
 		state = VB2_BUF_STATE_ERROR;
@@ -245,12 +264,19 @@ static int cedrus_suspend(struct device *dev)
 {
 	struct cedrus_device *cedrus_dev = dev_get_drvdata(dev);
 
+	/*
+	 * Quiesce the engine and hold it in reset before gating its clocks:
+	 * gating bus/ram clocks under a live VE has been seen to hang the
+	 * V831 bus.
+	 */
+	writel(VE_MODE_DEC_DISABLED, cedrus_dev->io_base + VE_MODE_REG);
+	reset_control_assert(cedrus_dev->reset);
+	udelay(1);
+
 	clk_disable_unprepare(cedrus_dev->clock_ram);
 	clk_disable_unprepare(cedrus_dev->clock_mod);
 	clk_disable_unprepare(cedrus_dev->clock_ahb);
 
-	reset_control_assert(cedrus_dev->reset);
-
 	return 0;
 }
 
@@ -259,9 +285,9 @@ static int cedrus_resume(struct device *dev)
 	struct cedrus_device *cedrus_dev = dev_get_drvdata(dev);
 	int ret;
 
-	ret = reset_control_reset(cedrus_dev->reset);
+	ret = reset_control_assert(cedrus_dev->reset);
 	if (ret) {
-		dev_err(dev, "failed to reset\n");
+		dev_err(dev, "failed to assert reset\n");
 		return ret;
 	}
 
@@ -283,6 +309,14 @@ static int cedrus_resume(struct device *dev)
 		goto error_clock_mod;
 	}
 
+	udelay(1);
+	ret = reset_control_deassert(cedrus_dev->reset);
+	if (ret) {
+		dev_err(dev, "failed to deassert reset\n");
+		clk_disable_unprepare(cedrus_dev->clock_ram);
+		goto error_clock_mod;
+	}
+
 	return 0;
 
 error_clock_mod:
@@ -317,6 +351,7 @@ static int cedrus_resources_setup(struct cedrus_device *cedrus_dev,
 		return -EINVAL;
 
 	cedrus_dev->capabilities = variant->capabilities;
+	cedrus_dev->sram_remap_reg = variant->sram_remap_reg;
 
 	/* Registers */
 
@@ -385,7 +420,19 @@ static int cedrus_resources_setup(struct cedrus_device *cedrus_dev,
 
 	/* SRAM */
 
-	ret = sunxi_sram_claim(dev);
+	if (variant->sram_remap_reg) {
+		void __iomem *sram = devm_platform_ioremap_resource(platform_dev, 1);
+
+		if (IS_ERR(sram)) {
+			ret = PTR_ERR(sram);
+			goto error_memory;
+		}
+		/* Hand SRAM C to the VE (same sequence as vendor sun8iw19). */
+		writel(readl(sram) & 0x80000000, sram);
+		ret = 0;
+	} else {
+		ret = sunxi_sram_claim(dev);
+	}
 	if (ret) {
 		dev_err(dev, "failed to claim SRAM\n");
 		goto error_memory;
@@ -408,7 +455,8 @@ static void cedrus_resources_cleanup(struct cedrus_device *cedrus_dev)
 	struct device *dev = cedrus_dev->dev;
 
 	pm_runtime_disable(dev);
-	sunxi_sram_release(dev);
+	if (!cedrus_dev->sram_remap_reg)
+		sunxi_sram_release(dev);
 	of_reserved_mem_device_release(dev);
 }
 
@@ -514,6 +562,13 @@ static const struct cedrus_variant cedrus_variant_sun8i_v3s = {
 	.clock_mod_rate	= 402000000,
 };
 
+static const struct cedrus_variant cedrus_variant_sun8i_v831 = {
