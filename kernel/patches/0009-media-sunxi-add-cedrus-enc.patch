 .../platform/sunxi/sun8i-cedrus-enc/Makefile      |   4 +-
 .../platform/sunxi/sun8i-cedrus-enc/cedrus.c      |  75 ++-
 .../platform/sunxi/sun8i-cedrus-enc/cedrus.h      |   4 +-
 .../sunxi/sun8i-cedrus-enc/cedrus_context.c       |  24 +-
 .../sunxi/sun8i-cedrus-enc/cedrus_context.h       |   5 +-
 .../platform/sunxi/sun8i-cedrus-enc/cedrus_enc.c  |  27 +-
 .../sunxi/sun8i-cedrus-enc/cedrus_enc_h264.c      | 505 +++++++++++++++-----
 .../sunxi/sun8i-cedrus-enc/cedrus_enc_h264.h      |  19 +
 .../platform/sunxi/sun8i-cedrus-enc/cedrus_proc.c |   7 +-
 10 files changed, 533 insertions(+), 148 deletions(-)

diff --git a/drivers/media/platform/sunxi/sun8i-cedrus-enc/Kconfig b/drivers/media/platform/sunxi/sun8i-cedrus-enc/Kconfig
index 0dbba717c9b2b2e0ceffc52082ab6b0723f87c38..e7d4cb5d29ef6bd6e2540282cec8f07c9ef13328 100644
--- a/drivers/media/platform/sunxi/sun8i-cedrus-enc/Kconfig
+++ b/drivers/media/platform/sunxi/sun8i-cedrus-enc/Kconfig
@@ -1,16 +1,17 @@
 # SPDX-License-Identifier: GPL-2.0
-config VIDEO_SUNXI_CEDRUS
-	tristate "Allwinner Cedrus Video Engine Driver"
+config VIDEO_SUN8I_CEDRUS_ENC
+	tristate "Allwinner Cedrus video engine with H.264 encoder (V831)"
 	depends on V4L_PLATFORM_DRIVERS && VIDEO_DEV
 	depends on ARCH_SUNXI || COMPILE_TEST
 	depends on PM && COMMON_CLK && RESET_CONTROLLER && HAS_DMA
 	select MEDIA_CONTROLLER
-	select MEDIA_CONTROLLER_REQUEST_API
 	select VIDEOBUF2_DMA_CONTIG
 	select V4L2_MEM2MEM_DEV
 	select SUNXI_SRAM
 	help
-	  Support for the Allwinner Video Engine.
+	  The staging Cedrus driver reworked by Bootlin into decoder and
+	  encoder "procs", with the H.264 encoder brought up on the V831
+	  video engine. Independent of VIDEO_SUNXI_CEDRUS (do not load both).
 
 	  To compile this driver as a module, choose M here: the module
-	  will be called sunxi-cedrus.
+	  will be called cedrus-enc.
