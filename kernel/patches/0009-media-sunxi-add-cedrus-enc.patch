 	/* Format */
 
 	cedrus_write(dev, VE_ISP_CTRL_REG,
diff --git a/drivers/media/platform/sunxi/sun8i-cedrus-enc/cedrus_enc_h264.c b/drivers/media/platform/sunxi/sun8i-cedrus-enc/cedrus_enc_h264.c
index e307e26e46ee4da4ad96decc5e16aeb2920699ae..c6c84017eb8dfae1b8bea0d2864722ff79d02b12 100644
--- a/drivers/media/platform/sunxi/sun8i-cedrus-enc/cedrus_enc_h264.c
+++ b/drivers/media/platform/sunxi/sun8i-cedrus-enc/cedrus_enc_h264.c
@@ -6,6 +6,8 @@
  * Author: Paul Kocialkowski <paul.kocialkowski@bootlin.com>
  */
 
+#include <linux/delay.h>
+#include <linux/module.h>
 #include <linux/align.h>
 #include <linux/sizes.h>
 #include <linux/types.h>
@@ -22,6 +24,92 @@
 #include "cedrus_proc.h"
 #include "cedrus_regs.h"
 
+/*
+ * V831 bring-up: some address registers appear to be in 256-byte units
+ * (IOMMU fault at reg<<8). Bit i of addr_shift selects shift_regs[i].
+ */
+static unsigned int addr_shift = 0x1f98;	/* V831: these regs take addr >> 8 */
+/* V831 (IC 0x21110, "layout 1"): PARA1 bit 27 = 8x8 transform disable */
+static unsigned int para1_or = BIT(27);
+module_param(para1_or, uint, 0644);
+static int me_para = 0x11200;	/* vendor layout-1 value */
+module_param(me_para, int, 0644);
+module_param(addr_shift, uint, 0644);
+MODULE_PARM_DESC(addr_shift, "bitmask of address regs to program as addr>>8");
+
+/* --- V831 bring-up: canary guard zones after VE-internal buffers --- */
+/*
+ * Debug only: canary bytes after each VE buffer, checked after every job.
+ * The check reads uncached DMA memory and costs ~1.4 ms per KiB of guard
+ * per frame, so it is off by default (the IOMMU catches stray accesses).
+ */
+static unsigned int guard_bytes;
+module_param(guard_bytes, uint, 0444);
+#define CEDRUS_GUARD	guard_bytes
+#define CEDRUS_CANARY	0x5a
+struct cedrus_guard { const char *name; u8 *cpu; dma_addr_t dma; size_t size; };
+static struct cedrus_guard cedrus_guards[16];
+
+static void *cedrus_galloc(struct device *dev, size_t size, dma_addr_t *dma,
+			   const char *name)
+{
+	u8 *p = dma_alloc_attrs(dev, size + CEDRUS_GUARD, dma, GFP_KERNEL,
+				 DMA_ATTR_FORCE_CONTIGUOUS);
+	unsigned int i;
+
+	if (!p)
+		return NULL;
+	if (CEDRUS_GUARD)
+		memset(p + size, CEDRUS_CANARY, CEDRUS_GUARD);
+	for (i = 0; i < ARRAY_SIZE(cedrus_guards); i++)
+		if (!cedrus_guards[i].cpu) {
+			cedrus_guards[i] = (struct cedrus_guard){ name, p, *dma, size };
+			break;
+		}
+	pr_info("cedrus-enc: %s @%pad size %zu (+%u guard)\n", name, dma, size,
+		CEDRUS_GUARD);
+	return p;
+}
