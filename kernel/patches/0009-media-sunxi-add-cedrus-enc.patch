@@ -149,7 +152,7 @@ static void cedrus_v4l2_cleanup(struct cedrus_device *cedrus_dev)
 
 /* Platform */
 
-void cedrus_watchdog(struct work_struct *work)
+static void cedrus_watchdog(struct work_struct *work)
 {
 	struct cedrus_device *cedrus_dev =
 		container_of(to_delayed_work(work), struct cedrus_device,
@@ -230,6 +233,22 @@ static irqreturn_t cedrus_irq(int irq, void *private)
 		return IRQ_NONE;
 
 	cedrus_irq_disable_clear(ctx);
+	{
+		extern u64 cedrus_t_run, cedrus_t_trig;
+		extern unsigned int cedrus_timing;
+
+		if (cedrus_timing) {
+			u64 t = ktime_get_ns();
+			u32 rem;
+			u64 ms = div_u64_rem(cedrus_t_run, 1000000, &rem);
+
+			cedrus_timing--;
+			pr_info("cedrus-enc: run@%llu.%03u ms run->trigger %llu us, trigger->irq %llu us\n",
+				ms, rem / 1000,
+				div_u64(cedrus_t_trig - cedrus_t_run, 1000),
