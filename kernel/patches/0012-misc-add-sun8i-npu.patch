index 0000000000000000000000000000000000000000..8cf2e288ab38003c0b5b3d3151777b8a0f694d73
--- /dev/null
+++ b/drivers/misc/sun8i-npu/Kconfig
@@ -0,0 +1,12 @@
+# SPDX-License-Identifier: GPL-2.0
+config SUN8I_NPU
+	tristate "Allwinner V831 NPU (NVDLA nv_small)"
+	depends on ARCH_SUNXI || COMPILE_TEST
+	depends on COMMON_CLK && RESET_CONTROLLER && HAS_DMA
+	help
+	  Minimal /dev/npu driver: power, clocks, resets, an mmap of the
+	  register window and physically contiguous buffers. The NPU is
+	  programmed from userspace.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called sun8i-npu.
diff --git a/drivers/misc/sun8i-npu/Makefile b/drivers/misc/sun8i-npu/Makefile
new file mode 100644
index 0000000000000000000000000000000000000000..a2606a8e65deb4d1a379f817ca5e67bc57078939
--- /dev/null
+++ b/drivers/misc/sun8i-npu/Makefile
@@ -0,0 +1,3 @@
